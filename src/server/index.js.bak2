// POST - Login de usuarios/agentes
app.post('/api/auth/login', async (req, res) => {
    const { email, password } = req.body;
    
    if (!email || !password) {
        return res.status(400).json({ success: false, error: 'Email and password are required' });
    }
    
    if (!pool) {
        return res.status(503).json({ success: false, error: 'Database not available' });
    }
    
    try {
        const bcrypt = require('bcrypt');
        const connection = await pool.getConnection();
        
        try {
            // Buscar usuario por email
            const [users] = await connection.execute(
                'SELECT id, name, email, password, role, department, category, status, phone, avatar_url FROM users WHERE email = ?',
                [email]
            );
            
            if (users.length === 0) {
                return res.status(401).json({ success: false, error: 'Invalid email or password' });
            }
            
            const user = users[0];
            
            // Verificar si está activo
            if (user.status !== 'active') {
                return res.status(403).json({ success: false, error: 'Account is inactive or suspended' });
            }
            
            // Verificar contraseña
            const passwordMatch = await bcrypt.compare(password, user.password);
            
            if (!passwordMatch) {
                return res.status(401).json({ success: false, error: 'Invalid email or password' });
            }
            
            // Actualizar último login
            await connection.execute(
                'UPDATE users SET last_login = NOW() WHERE id = ?',
                [user.id]
            );
            
            // No enviar password en la respuesta
            delete user.password;
            
            // Generar token simple (en producción usar JWT)
            const token = Buffer.from(`${user.id}:${user.email}:${Date.now()}`).toString('base64');
            
            // Para agentes y supervisores, obtener el sessionId activo del sistema
            let sessionId = null;
            if (user.role === 'agent' || user.role === 'supervisor') {
                // Buscar la sesión activa donde phone_number sea diferente de session_id
                // (esto indica que es una sesión real de WhatsApp)
                const [sessions] = await connection.execute(
                    `SELECT session_id, phone_number FROM user_sessions 
                     WHERE is_active = true 
                     AND phone_number != session_id
                     ORDER BY last_activity DESC 
                     LIMIT 1`
                );
                
                if (sessions.length > 0) {
                    sessionId = sessions[0].session_id;
                    console.log(`[AUTH] ✅ Agente/Supervisor ${email} asignado a sesión activa: ${sessionId} (${sessions[0].phone_number})`);
                } else {
                    console.log(`[AUTH] ⚠️ No hay sesión activa con WhatsApp vinculado para ${email}`);
                }
            }
            
            console.log(`[AUTH] ✅ Login exitoso: ${email} (${user.role})`);
            
            res.json({ 
                success: true, 
                user,
                token,
                sessionId, // Agregar sessionId a la respuesta
                message: 'Login successful'
            });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[AUTH] Error en login:', error);
        res.status(500).json({ success: false, error: error.message });
    }
});

// GET - Obtener sesión activa del sistema (para agentes/supervisores)
app.get('/api/sessions/active', async (req, res) => {
    try {
        // Buscar sesiones activas y CONECTADAS en memoria
        for (const [sessionId, sessionInfo] of sessions.entries()) {
            if (sessionInfo.isConnected) {
                console.log(`✅ Sesión activa y conectada encontrada: ${sessionId}`);
                return res.json({ 
                    success: true,
                    isConnected: true,
                    sessionId: sessionId,
                    phoneNumber: sessionId // El sessionId ya es el número de teléfono después de conectar
                });
            }
        }
        
        // Si llegamos aquí, no hay sesiones conectadas en memoria
        console.log('⚠️ No hay sesiones activas de WhatsApp conectadas');
        return res.json({ 
            success: false,
            isConnected: false,
            error: 'No hay sesiones activas de WhatsApp' 
        });
    } catch (error) {
        console.error('[SESSIONS] Error getting active session:', error);
        res.status(500).json({ success: false, error: error.message });
    }
});


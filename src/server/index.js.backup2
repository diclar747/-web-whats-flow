            });
        }

        if (!pool) {
            return res.status(500).json({
                success: false,
                error: 'Base de datos no disponible'
            });
        }

        const connection = await pool.getConnection();
        try {
            const [result] = await connection.execute(
                'INSERT INTO kanban_boards (session_id, name, color) VALUES (?, ?, ?)',

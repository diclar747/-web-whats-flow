// Endpoint para forzar sincronizaci�n de grupos con miembros reales
app.post('/api/force-sync-groups', async (req, res) => {
    const { sessionId } = req.body;
    
    if (!sessionId) {
        return res.status(400).json({
            success: false,
            error: 'sessionId es requerido'
        });
    }
    
    try {
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no encontrada o no conectada'
            });
        }
        
        console.log(`[FORCE-SYNC] Iniciando sincronizaci�n forzada para sesi�n: ${sessionId}`);
        
        // Obtener todos los grupos del usuario
        const groups = await session.sock.groupFetchAllParticipating();
        console.log(`[FORCE-SYNC] Se encontraron ${Object.keys(groups).length} grupos`);
        
        let totalGroups = 0;
        let totalMembers = 0;
        let errors = 0;
        
        // Procesar cada grupo individualmente
        for (const [groupId, groupData] of Object.entries(groups)) {
            try {
                if (groupId.includes('@g.us') && typeof groupData === 'object') {
                    console.log(`[FORCE-SYNC] Procesando grupo: ${groupId}`);
                    
                    // Buscar user_session_id
                    const connection = await pool.getConnection();
                    try {
                        const [userSessionResult] = await connection.execute(
                            'SELECT id FROM user_sessions WHERE session_id = ?',
                            [sessionId]
                        );
                        
                        if (userSessionResult.length === 0) {
                            console.error(`[FORCE-SYNC] User session no encontrada para: ${sessionId}`);
                            continue;
                        }
                        
                        const userSessionId = userSessionResult[0].id;
                        
                        // Guardar informaci�n del grupo
                        await saveGroupToDatabase(groupId, groupData, userSessionId);
                        totalGroups++;
                        
                        // Guardar miembros del grupo usando la funci�n mejorada
                        const membersCount = await saveGroupMembersToDatabase(groupId, groupData, userSessionId, session.sock, sessionId);
                        totalMembers += membersCount;
                        
                        console.log(`[FORCE-SYNC] Grupo ${groupId} procesado: ${membersCount} miembros`);
                        
                    } finally {
                        connection.release();
                    }
                }
            } catch (groupError) {
                console.error(`[FORCE-SYNC] Error procesando grupo ${groupId}:`, groupError);
                errors++;
            }
        }
        
        console.log(`[FORCE-SYNC] Completado: ${totalGroups} grupos, ${totalMembers} miembros, ${errors} errores`);
        
        res.json({
            success: true,
            stats: {
                groupsProcessed: totalGroups,
                membersSaved: totalMembers,
                errors,
                message: `Sincronizaci�n forzada completada: ${totalGroups} grupos, ${totalMembers} miembros`
            }
        });
        
    } catch (error) {
        console.error('[FORCE-SYNC] Error en sincronizaci�n forzada:', error);
        res.status(500).json({
            success: false,
            error: error.message
        });
    }
});


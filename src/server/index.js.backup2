            + 'chat_name VARCHAR(255) NOT NULL,'
            + 'session_id VARCHAR(255) NOT NULL,'
            + 'from_agent_id VARCHAR(255),'
            + 'to_agent_id VARCHAR(255) NOT NULL,'
            + 'status ENUM(\'pending\', \'accepted\', \'rejected\', \'closed\') DEFAULT \'pending\','
            + 'last_message TEXT,'
            + 'unread_count INT DEFAULT 0,'
            + 'transferred_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,'
            + 'accepted_at TIMESTAMP NULL,'
            + 'closed_at TIMESTAMP NULL,'
            + 'close_reason TEXT,'
            + 'INDEX idx_to_agent (to_agent_id),'
            + 'INDEX idx_status (status),'
            + 'INDEX idx_chat_id (chat_id)'
            + ') ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;'
        );
        console.log('[DB-TABLES] Table \'chat_transfers\' ensured.');

        console.log('[DB-TABLES] All tables ensured successfully.');

    } catch (error) {
        console.error('[DB-TABLES] Full error during createTables:', error);
        if (connection) {
            console.error('[DB-TABLES] Error occurred after connection was established.');
        } else {
            console.error('[DB-TABLES] Error occurred before connection was established from pool.');
        }
    } finally {
        if (connection) {
            connection.release();
            console.log('[DB-TABLES] Connection released.');
        }
    }
}

// Helper function to get or insert/update contact in DB
async function getOrInsertContact(jid, name = null, notifyName = null, isGroup = false, phoneNumber = null) {
    console.log(`[DB-CONTACT-CALL] Called getOrInsertContact for jid: ${jid}, name: ${name}, notifyName: ${notifyName}, isGroup: ${isGroup}, phoneNumber: ${phoneNumber}`);
    
    // Validar que el phone_number tenga valor, si no, registrar advertencia
    if (!phoneNumber) {
        console.warn(`[DB-CONTACT-WARN] Called getOrInsertContact without phone_number for jid: ${jid}. This may cause issues filtering contacts by session.`);
    }
    
    // Modo memoria si no hay DB
    if (process.env.SKIP_DB === 'true' || !pool) {
        if (!memoryStorage.contacts.has(jid)) {
            const contactData = {
                id: Date.now() + Math.random(),
                jid,
                name: name || notifyName || jid.split('@')[0],
                notify_name: notifyName || name || jid.split('@')[0],
                is_group: isGroup,
                session_id: phoneNumber, // Usamos phone_number en lugar de session_id
                created_at: new Date()
            };
            memoryStorage.contacts.set(jid, contactData);
            console.log(`[MEMORY-CONTACT] Contact ${jid} stored in memory with phone_number: ${phoneNumber}`);
        }
        return memoryStorage.contacts.get(jid).id;
    }
    
    if (!pool) {
        console.error('[DB-CONTACT] DB Pool not initialized!');
        return null;
    }
    const connection = await pool.getConnection();
    try {
        console.log(`[DB-CONTACT-QUERY] Attempting to find existing contact for jid: ${jid} and session_id: ${phoneNumber}`);
        let [rows] = await connection.execute(
            'SELECT id, name, notify_name, session_id FROM contacts WHERE jid = ? AND session_id = ?',
            [jid, phoneNumber]
        );
        console.log(`[DB-CONTACT-QUERY-RESULT] Found ${rows.length} existing contacts for jid: ${jid} and session_id: ${phoneNumber}`);
        
        const contactName = name || notifyName || jid.split('@')[0];
        const contactNotifyName = notifyName || name || jid.split('@')[0];

        if (rows.length > 0) {
            // Contact exists, return its ID
            return rows[0].id;
        } else {
            // Contact does not exist, insert with ON DUPLICATE KEY UPDATE
            console.log(`[DB-CONTACT-INSERT] Attempting to insert or update contact jid: ${jid} with name: ${contactName}, notifyName: ${contactNotifyName}, isGroup: ${isGroup}, phone_number: ${phoneNumber}`);
            const [result] = await connection.execute(
                `INSERT INTO contacts (jid, name, notify_name, is_group, session_id)
                 VALUES (?, ?, ?, ?, ?)
                 ON DUPLICATE KEY UPDATE
                    name = IF(VALUES(name) IS NOT NULL AND VALUES(name) != '', VALUES(name), name),
                    notify_name = IF(VALUES(notify_name) IS NOT NULL AND VALUES(notify_name) != '', VALUES(notify_name), notify_name),
                    updated_at = CURRENT_TIMESTAMP`,
                [jid, contactName, contactNotifyName, isGroup, phoneNumber]
            );
            console.log(`[DB-CONTACT-UPSERT-SUCCESS] Contact ${jid} upserted into DB with phone_number: ${phoneNumber}.`);

            // Get the contact ID
            if (result.insertId) {
                return result.insertId;
            } else {
                // If it was an update, get the ID
                let [updatedRows] = await connection.execute(
                    'SELECT id FROM contacts WHERE jid = ? AND session_id = ?',
                    [jid, phoneNumber]
                );
                return updatedRows[0]?.id || null;
            }
        }
    } catch (error) {
        console.error(`[DB-CONTACT] Error in getOrInsertContact for ${jid}:`, error);
        return null;
    } finally {
        if (connection) connection.release();
    }
}

// Helper function to save a message to the database
async function saveMessageToDB(sessionId, msg) {
    console.log(`[DB-MSG-CALL] Called saveMessageToDB for session: ${sessionId}, messageId: ${msg.id}, chat_jid: ${msg.chat_jid}`);

    // Obtener el n�mero de tel�fono del usuario en lugar de la session_id temporal
    const phoneNumber = await getUserPhoneNumber(sessionId);

    if (!phoneNumber) {
        console.error(`[DB-MSG] No se pudo obtener phoneNumber para sessionId ${sessionId}. No se puede guardar mensaje ${msg.id}.`);
        return null;
    }

    // Modo memoria si no hay DB
    if (process.env.SKIP_DB === 'true' || !pool || memoryStorage.isMemoryMode) {
        const messageKey = `${phoneNumber || sessionId}_${msg.id}`;
        memoryStorage.messages.set(messageKey, {
            ...msg,
            session_id: phoneNumber, // Usar n�mero de tel�fono en lugar de session_id
            created_at: new Date()
        });
        console.log(`[MEMORY-MSG] Message ${msg.id} stored in memory for phone number ${phoneNumber}`);
        return { affectedRows: 1, insertId: Date.now() };
    }

    if (!pool) {
        console.error('[DB-MSG] DB Pool not initialized!');
        return null;
    }

    // Obtener user_session_id
    const userSessionId = await getUserSessionId(sessionId);

    const connection = await pool.getConnection();
    try {
        const {
            id: messageId, // Baileys message ID
            chat_jid, // JID of the chat (contact or group)
            sender_jid, // JID of the actual sender (can be different from chat_jid in groups)
            from_me,
            message_type,
            text_content,
            media_url,
            media_mime_type,
            timestamp, // Should be a JS Date object or a string parsable by new Date()
            status = 'sent' // Default status, can be updated later
        } = msg;

        // Ensure timestamp is in YYYY-MM-DD HH:MM:SS format for MySQL DATETIME
        const mysqlTimestamp = new Date(timestamp).toISOString().slice(0, 19).replace('T', ' ');

        // Define los par�metros para la consulta, convirtiendo undefined a null donde sea necesario
        const finalSenderJid = sender_jid || chat_jid;
        const params = [
            messageId,
            phoneNumber, // Usar n�mero de tel�fono en lugar de session_id temporal
            userSessionId, // Agregar user_session_id
            chat_jid,
            finalSenderJid,
            from_me,
            message_type || null, // Asegurar null si message_type es undefined
            text_content || null,
            media_url || null,
            media_mime_type || null,
            mysqlTimestamp,
            status || 'pending' // Asegurar un estado por defecto si es undefined
        ];

        console.log(`[DB-MSG-QUERY] Attempting to insert/update messageId: ${messageId} for phone number: ${phoneNumber}, user_session_id: ${userSessionId}, chat_jid: ${chat_jid}, sender_jid: ${finalSenderJid}, from_me: ${from_me}, type: ${params[6]}, status: ${params[11]}`);
        const [result] = await connection.execute(
            'INSERT INTO messages (id, session_id, user_session_id, chat_jid, sender_jid, from_me, message_type, text_content, media_url, media_mime_type, timestamp, status) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON DUPLICATE KEY UPDATE status = VALUES(status), updated_at = CURRENT_TIMESTAMP',
            params
        );
        console.log(`[DB-MSG-QUERY-RESULT] Result for messageId ${messageId}: affectedRows: ${result.affectedRows}, insertId: ${result.insertId !== undefined ? result.insertId : 'N/A (update)'}`);

        if (result.affectedRows > 0) {
             if (result.insertId !== 0 && result.insertId !== undefined) { // insertId is 0 for ON DUPLICATE KEY UPDATE if no new row was inserted
                console.log(`[DB-MSG] Message ${messageId} for phone number ${phoneNumber} inserted into DB.`);
             } else {
                console.log(`[DB-MSG] Message ${messageId} for phone number ${phoneNumber} updated in DB (e.g. status).`);
             }
        } else {
            // This case might happen if ON DUPLICATE KEY UPDATE didn't change anything or no insert occurred.
            // For messages, usually an insert or an update (if status changes) is expected.
            console.log(`[DB-MSG] Message ${messageId} for phone number ${phoneNumber} - no change in DB (already exists with same status?).`);
        }
        return result;

    } catch (error) {
        console.error(`[DB-MSG] Error in saveMessageToDB for message ${msg.id} in session ${sessionId}:`, error);
        // If it's a duplicate entry error on 'id' (PRIMARY KEY), we can often ignore it if content is the same.
        // However, our ON DUPLICATE KEY UPDATE should handle most cases.
        if (error.code === 'ER_DUP_ENTRY') {
            console.warn(`[DB-MSG] Attempted to insert duplicate message ID: ${msg.id}. Update logic should handle this.`);
        }
        return null;
    } finally {
        if (connection) connection.release();
    }
}

// Funci�n para obtener el n�mero de tel�fono del usuario de la sesi�n
async function getUserPhoneNumber(sessionId) {
    const session = sessions.get(sessionId);
    if (session && session.sock && session.sock.user) {
        // El user.id viene en formato como "5491234567890:XX@s.whatsapp.net"
        const userJid = session.sock.user.id;
        const phoneNumber = userJid.split(':')[0]; // Extraer solo el n�mero
        console.log(`[${sessionId}] Usuario identificado: ${phoneNumber}`);
        return phoneNumber;
    }
    return null;
}

// Funci�n para obtener el user_session_id a partir del session_id
async function getUserSessionId(sessionId) {
    // Modo memoria
    if (process.env.SKIP_DB === 'true' || !pool || memoryStorage.isMemoryMode) {
        if (memoryStorage.userSessions.has(sessionId)) {
            return memoryStorage.userSessions.get(sessionId).id;
        }
        return null;
    }

    if (!pool) {
        console.error('[DB-USER-ID] DB Pool not initialized!');
        return null;
    }

    const connection = await pool.getConnection();
    try {
        const [rows] = await connection.execute(
            'SELECT id FROM user_sessions WHERE session_id = ? ORDER BY last_activity DESC LIMIT 1',
            [sessionId]
        );

        if (rows.length > 0) {
            return rows[0].id;
        }

        // Si no existe, intentar obtener desde la sesi�n activa y crear
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (phoneNumber) {
            const userSessionId = await getOrCreateUserSession(sessionId, phoneNumber);
            return userSessionId;
        }

        return null;
    } catch (error) {
        console.error(`[DB-USER-ID] Error obteniendo user_session_id:`, error);
        return null;
    } finally {
        if (connection) connection.release();
    }
}

// Funci�n para crear/obtener sesi�n de usuario en la base de datos
async function getOrCreateUserSession(sessionId, phoneNumber) {
    if (!pool) {
        console.error('[DB-USER] DB Pool not initialized!');
        return null;
    }
    
    const connection = await pool.getConnection();
    try {
        // Crear tabla de sesiones de usuario si no existe
        await connection.query(
            'CREATE TABLE IF NOT EXISTS user_sessions ('
            + 'id INT AUTO_INCREMENT PRIMARY KEY,'
            + 'session_id VARCHAR(255) NOT NULL,'
            + 'phone_number VARCHAR(50) UNIQUE NOT NULL,'
            + 'is_active BOOLEAN DEFAULT TRUE,'
            + 'last_activity TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,'
            + 'created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,'
            + 'INDEX idx_session_id (session_id),'
            + 'INDEX idx_phone_number (phone_number)'
            + ') ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;'
        );

        // Buscar sesi�n existente por n�mero de tel�fono
        const [existingSessions] = await connection.execute(
            'SELECT id, session_id FROM user_sessions WHERE phone_number = ?',
            [phoneNumber]
        );

        let userSessionId;
        if (existingSessions.length > 0) {
            // Ya existe una sesi�n para este n�mero de tel�fono
            userSessionId = existingSessions[0].id;
            // Actualizar con el nuevo session_id y marcar como activa
            await connection.execute(
                'UPDATE user_sessions SET session_id = ?, is_active = TRUE, last_activity = CURRENT_TIMESTAMP WHERE phone_number = ?',
                [sessionId, phoneNumber]
            );
            console.log(`[DB-USER] Sesi�n existente actualizada para ${phoneNumber}: user_session_id ${userSessionId}`);
        } else {
            // Primera vez que este n�mero inicia sesi�n, crear nuevo registro
            const [result] = await connection.execute(
                'INSERT INTO user_sessions (session_id, phone_number, is_active) VALUES (?, ?, TRUE)',
                [sessionId, phoneNumber]
            );
            userSessionId = result.insertId;
            console.log(`[DB-USER] Nueva sesi�n creada para ${phoneNumber}: user_session_id ${userSessionId}`);
        }

        console.log(`[DB-USER] Sesi�n de usuario registrada: ${sessionId} -> ${phoneNumber} (user_session_id: ${userSessionId})`);
        return userSessionId;
    } catch (error) {
        console.error(`[DB-USER] Error managing user session:`, error);
        return null;
    } finally {
        if (connection) connection.release();
    }
}

// Helper function to deactivate a user session in the database
async function deactivateUserSession(phoneNumber) {
    if (!pool || memoryStorage.isMemoryMode) {
        console.log(`[DB-USER-DEACTIVATE] Skipping DB operation for phone number ${phoneNumber} (memory mode or no pool)`);
        // In memory mode, we might need to remove it from memoryStorage.userSessions if it exists
        if (memoryStorage.userSessions.has(phoneNumber)) {
            memoryStorage.userSessions.delete(phoneNumber);
            console.log(`[MEMORY-USER-DEACTIVATE] Removed session for ${phoneNumber} from memory.`);
        }
        return;
    }

    if (!pool) {
        console.error('[DB-USER-DEACTIVATE] DB Pool not initialized!');
        return;
    }

    const connection = await pool.getConnection();
    try {
        console.log(`[DB-USER-DEACTIVATE] Deactivating session for phone number: ${phoneNumber}`);
        const [result] = await connection.execute(
            'UPDATE user_sessions SET is_active = FALSE, last_activity = CURRENT_TIMESTAMP WHERE phone_number = ?',
            [phoneNumber]
        );
        if (result.affectedRows > 0) {
            console.log(`[DB-USER-DEACTIVATE] Session deactivated successfully for ${phoneNumber}.`);
        } else {
            console.log(`[DB-USER-DEACTIVATE] No active session found to deactivate for ${phoneNumber}.`);
        }
    } catch (error) {
        console.error(`[DB-USER-DEACTIVATE] Error deactivating user session for ${phoneNumber}:`, error);
    } finally {
        if (connection) connection.release();
    }
}

// Funci�n para crear tableros Kanban por defecto
async function createDefaultKanbanBoards(phoneNumber) {
    if (!pool) {
        console.log(`[KANBAN-DEFAULT] Base de datos no disponible`);
        return;
    }

    const connection = await pool.getConnection();
    try {
        // Verificar si ya existen tableros para este usuario
        const [existing] = await connection.execute(
            'SELECT COUNT(*) as count FROM kanban_boards WHERE session_id = ?',
            [phoneNumber]
        );

        if (existing[0].count > 0) {
            console.log(`[KANBAN-DEFAULT] Usuario ${phoneNumber} ya tiene ${existing[0].count} tableros. No se crean tableros por defecto.`);
            return;
        }

        // Crear 4 tableros por defecto
        const defaultBoards = [
            { name: 'Sin Categor�a', color: '#607d8b', order: 0, is_default: 1 },
            { name: 'Interesados', color: '#2196f3', order: 1, is_default: 0 },
            { name: 'Clientes', color: '#4caf50', order: 2, is_default: 0 },
            { name: 'Prospectos', color: '#ff9800', order: 3, is_default: 0 }
        ];

        console.log(`[KANBAN-DEFAULT] Creando ${defaultBoards.length} tableros por defecto para ${phoneNumber}...`);

        let sinCategoriaBoardId = null;

        for (const board of defaultBoards) {
            const boardId = `board_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;
            await connection.execute(
                'INSERT INTO kanban_boards (id, session_id, name, color, board_order, is_default) VALUES (?, ?, ?, ?, ?, ?)',
                [boardId, phoneNumber, board.name, board.color, board.order, board.is_default]
            );
            console.log(`[KANBAN-DEFAULT] ? Tablero "${board.name}" creado`);

            // Guardar el ID del tablero "Sin Categor�a"
            if (board.name === 'Sin Categor�a') {
                sinCategoriaBoardId = boardId;
            }
        }

        console.log(`[KANBAN-DEFAULT] ? Tableros por defecto creados exitosamente para ${phoneNumber}`);

    } catch (error) {
        console.error(`[KANBAN-DEFAULT] Error creando tableros por defecto:`, error);
    } finally {
        connection.release();
    }
}

// Funci�n para cargar contactos en el tablero "Sin Categor�a"
async function loadContactsToDefaultBoard(phoneNumber) {
    if (!pool) {
        console.log(`[KANBAN-LOAD] Base de datos no disponible`);
        return;
    }

    const connection = await pool.getConnection();
    try {
        // Obtener el tablero "Sin Categor�a" (is_default = 1)
        const [boards] = await connection.execute(
            'SELECT id FROM kanban_boards WHERE session_id = ? AND is_default = 1 LIMIT 1',
            [phoneNumber]
        );

        if (boards.length === 0) {
            console.log(`[KANBAN-LOAD] No se encontr� tablero "Sin Categor�a" para usuario ${phoneNumber}`);
            return;
        }

        const sinCategoriaBoardId = boards[0].id;

        // Verificar si ya hay contactos en el tablero
        const [existingContacts] = await connection.execute(
            'SELECT COUNT(*) as count FROM kanban_contacts WHERE board_id = ?',
            [sinCategoriaBoardId]
        );

        if (existingContacts[0].count > 0) {
            console.log(`[KANBAN-LOAD] El tablero "Sin Categor�a" ya tiene ${existingContacts[0].count} contactos. No se cargan m�s.`);
            return;
        }

        // Obtener todos los contactos del usuario
        const [contacts] = await connection.execute(
            'SELECT jid FROM contacts WHERE session_id = ? AND is_group = FALSE',
            [phoneNumber]
        );

        if (contacts.length > 0) {
            console.log(`[KANBAN-LOAD] Cargando ${contacts.length} contactos en tablero "Sin Categor�a"...`);

            let loadedCount = 0;
            for (const contact of contacts) {
                try {
                    await connection.execute(
                        'INSERT INTO kanban_contacts (board_id, contact_jid) VALUES (?, ?)',
                        [sinCategoriaBoardId, contact.jid]
                    );
                    loadedCount++;
                } catch (err) {
                    // Ignorar duplicados
                    if (err.code !== 'ER_DUP_ENTRY') {
                        console.error(`[KANBAN-LOAD] Error insertando contacto ${contact.jid}:`, err.message);
                    }
                }
            }

            console.log(`[KANBAN-LOAD] ? ${loadedCount} contactos cargados en "Sin Categor�a"`);
        } else {
            console.log(`[KANBAN-LOAD] No hay contactos disponibles para cargar en "Sin Categor�a"`);
        }

    } catch (error) {
        console.error(`[KANBAN-LOAD] Error cargando contactos en tablero por defecto:`, error);
    } finally {
        connection.release();
    }
}

// Funci�n para obtener extensi�n de archivo desde mimetype
function getExtensionFromMimeType(mimeType) {
    const mimeToExt = {
        'image/jpeg': '.jpg',
        'image/jpg': '.jpg',
        'image/png': '.png',
        'image/gif': '.gif',
        'image/webp': '.webp',
        'video/mp4': '.mp4',
        'video/3gpp': '.3gp',
        'video/quicktime': '.mov',  // iOS
        'audio/mp4': '.mp4',
        'audio/mpeg': '.mp3',
        'audio/ogg': '.ogg',
        'audio/webm': '.webm',
        'audio/aac': '.aac',
        'audio/mp4a-latm': '.m4a',
        'application/pdf': '.pdf',
        'application/msword': '.doc',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document': '.docx',
        'application/vnd.ms-excel': '.xls',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet': '.xlsx',
        'application/vnd.ms-powerpoint': '.ppt',
        'application/vnd.openxmlformats-officedocument.presentationml.presentation': '.pptx',
        'text/plain': '.txt',
        'text/csv': '.csv',
        'application/zip': '.zip',
        'application/x-rar-compressed': '.rar'
    };
    return mimeToExt[mimeType] || '.bin'; // bin como extensi�n por defecto
}

// Funci�n para descargar todos los avatares de contactos
async function downloadAllAvatars(sessionId, sock) {
    if (!pool) {
        console.log(`[${sessionId}] ?? Base de datos no disponible, saltando descarga de avatares`);
        return;
    }

    const connection = await pool.getConnection();
    try {
        // Obtener todos los contactos sin avatar
        const [contacts] = await connection.execute(
            'SELECT jid, name FROM contacts WHERE avatar_url IS NULL OR avatar_url = "" LIMIT 100'
        );

        console.log(`[${sessionId}] ??? Descargando avatares para ${contacts.length} contactos...`);
        let downloadedCount = 0;

        for (const contact of contacts) {
            try {
                const profilePicUrl = await sock.profilePictureUrl(contact.jid, 'image').catch(() => null);

                if (profilePicUrl) {
                    await connection.execute(
                        'UPDATE contacts SET avatar_url = ? WHERE jid = ?',
                        [profilePicUrl, contact.jid]
                    );
                    downloadedCount++;

                    if (downloadedCount % 10 === 0) {
                        console.log(`[${sessionId}] ??? Descargados ${downloadedCount}/${contacts.length} avatares...`);
                    }
                }

                // Delay peque�o para no saturar WhatsApp
                await new Promise(resolve => setTimeout(resolve, 100));

            } catch (err) {
                // Ignorar errores individuales de avatar
            }
        }

        console.log(`[${sessionId}] ? Descargados ${downloadedCount} avatares exitosamente`);

    } catch (error) {
        console.error(`[${sessionId}] ? Error descargando avatares:`, error.message);
    } finally {
        connection.release();
    }
}


// Funci�n para sincronizar grupos y miembros autom�ticamente
async function syncGroupsAndMembers(sessionId, sock, userSessionId) {
    console.log(`[GROUPS-SYNC] ?? Iniciando sincronizaci�n de grupos y miembros para sessionId: ${sessionId}`);
    
    try {
        // Obtener todos los grupos del usuario
        const groups = await sock.groupFetchAllParticipating();
        console.log(`[GROUPS-SYNC] ?? Se encontraron ${Object.keys(groups).length} grupos`);

        let groupsSaved = 0;
        let membersSaved = 0;
        let errors = 0;

        // Procesar cada grupo
        for (const [groupId, groupData] of Object.entries(groups)) {
            try {
                console.log(`[GROUPS-SYNC] ?? Procesando grupo: ${groupData.subject || groupId}`);
                console.log(`[GROUPS-SYNC] ?? groupData.participants existe: ${!!groupData.participants}`);
                console.log(`[GROUPS-SYNC] ?? groupData.participants es array: ${Array.isArray(groupData.participants)}`);
                console.log(`[GROUPS-SYNC] ?? Cantidad en groupData.participants: ${groupData.participants?.length || 0}`);

                // Guardar informaci�n del grupo en la base de datos
                await saveGroupToDatabase(groupId, groupData, userSessionId);
                groupsSaved++;

                // NO llamar a groupMetadata() porque devuelve @lid
                // Usar directamente groupData de groupFetchAllParticipating()
                console.log(`[GROUPS-SYNC] ?? Usando datos de groupFetchAllParticipating()`);
                console.log(`[GROUPS-SYNC] ?? groupData.participants:`, JSON.stringify(groupData.participants));

                // Guardar miembros del grupo con los datos originales
                const membersCount = await saveGroupMembersToDatabase(groupId, groupData, userSessionId, sock, sessionId);
                membersSaved += membersCount;

                console.log(`[GROUPS-SYNC] ? Grupo "${groupData.subject}" guardado con ${membersCount} miembros`);

            } catch (groupError) {
                console.error(`[GROUPS-SYNC] ? Error procesando grupo ${groupId}:`, groupError);
                errors++;
            }
        }

        console.log(`[GROUPS-SYNC] ? Sincronizaci�n completada: ${groupsSaved} grupos, ${membersSaved} miembros, ${errors} errores`);
        
        return {
            groupsSaved,
            membersSaved,
            errors,
            totalGroups: Object.keys(groups).length
        };

    } catch (error) {
        console.error(`[GROUPS-SYNC] ? Error en sincronizaci�n de grupos:`, error);
        throw error;
    }
}

// Funci�n para guardar informaci�n del grupo en la base de datos
async function saveGroupToDatabase(groupId, groupData, userSessionId) {
    const connection = await pool.getConnection();
    
    try {
        // Normalizar el JID del grupo
        const normalizedGroupJid = groupId.includes('@') ? groupId : `${groupId}@g.us`;
        
        // Extraer informaci�n del grupo
        const groupName = groupData.subject || 'Sin nombre';
        const description = groupData.desc || '';
        const avatarUrl = groupData.previewUrl || '';
        const participantsCount = groupData.participants ? groupData.participants.length : 0;
        const isAnnouncement = groupData.announce ? 1 : 0;
        const isRestricted = groupData.restrict ? 1 : 0;

        // Insertar o actualizar el grupo en la base de datos
        const [result] = await connection.execute(
            `INSERT INTO contact_groups (
                jid, name, description, avatar_url, participants_count,
                is_announcement, is_restricted, user_session_id, created_at, updated_at
            ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, NOW(), NOW())
            ON DUPLICATE KEY UPDATE
                name = VALUES(name),
                description = VALUES(description),
                avatar_url = VALUES(avatar_url),
                participants_count = VALUES(participants_count),
                is_announcement = VALUES(is_announcement),
                is_restricted = VALUES(is_restricted),
                updated_at = NOW()`,
            [
                normalizedGroupJid,
                groupName,
                description,
                avatarUrl,
                participantsCount,
                isAnnouncement,
                isRestricted,
                userSessionId
            ]
        );

        return result;

    } finally {
        connection.release();
    }
}

// Funci�n para guardar miembros del grupo en la base de datos
async function saveGroupMembersToDatabase(groupId, groupData, userSessionId, sock, sessionId = null) {
    console.log(`[GROUPS-SYNC] ?? saveGroupMembersToDatabase llamada para grupo: ${groupId}`);

    // Verificar pool primero
    if (!pool) {
        console.error(`[GROUPS-SYNC] ??? POOL DE MYSQL NO EXISTE!`);
        return 0;
    }

    let connection;
    try {
        console.log(`[GROUPS-SYNC] ?? Obteniendo conexi�n del pool...`);
        connection = await pool.getConnection();
        console.log(`[GROUPS-SYNC] ? Conexi�n obtenida exitosamente`);

        // Verificar que la tabla contact_group_members existe
        console.log(`[GROUPS-SYNC] ?? Verificando que tabla contact_group_members existe...`);
        const [tables] = await connection.execute("SHOW TABLES LIKE 'contact_group_members'");
        if (tables.length === 0) {
            console.error(`[GROUPS-SYNC] ??? TABLA contact_group_members NO EXISTE EN LA BASE DE DATOS!`);
            return 0;
        }
        console.log(`[GROUPS-SYNC] ? Tabla contact_group_members existe`);

    } catch (connError) {
        console.error(`[GROUPS-SYNC] ??? ERROR AL OBTENER CONEXI�N O VERIFICAR TABLA:`, connError);
        return 0;
    }

    try {
        const normalizedGroupJid = groupId.includes('@') ? groupId : `${groupId}@g.us`;
        let membersSaved = 0;

        console.log(`[GROUPS-SYNC] ?? groupData recibido:`, JSON.stringify(Object.keys(groupData)));
        console.log(`[GROUPS-SYNC] ?? groupData.participants existe: ${!!groupData.participants}`);
        console.log(`[GROUPS-SYNC] ?? groupData.participants es array: ${Array.isArray(groupData.participants)}`);

        if (!groupData.participants || !Array.isArray(groupData.participants)) {
            console.log(`[GROUPS-SYNC] ? NO HAY PARTICIPANTES O NO ES ARRAY - Retornando 0`);
            console.log(`[GROUPS-SYNC] ?? groupData completo:`, JSON.stringify(groupData, null, 2));
            return 0;
        }

        console.log(`[GROUPS-SYNC] ?? Procesando ${groupData.participants.length} miembros del grupo ${groupId}`);

        // NUEVA ESTRATEGIA: Los participantes vienen con @lid (in�til)
        // Pero los contactos del grupo YA EST�N en la tabla contacts con @s.whatsapp.net
        // Soluci�n: Usar TODOS los contactos como posibles miembros del grupo

        const userPhoneNumber = await getUserPhoneNumber(sessionId);

        console.log(`[GROUPS-SYNC] ?? NUEVA ESTRATEGIA: Obteniendo miembros desde metadata detallada...`);

        // Procesar cada miembro del grupo
        for (const participant of groupData.participants) {
            try {
                console.log(`[GROUPS-SYNC] ?? Procesando participante completo:`, JSON.stringify(participant));

                const contactJid = participant.id;
                const isAdmin = participant.admin ? 1 : 0;
                const isSuperAdmin = participant.superAdmin ? 1 : 0;

                console.log(`[GROUPS-SYNC] ?? JID: ${contactJid}, Admin: ${isAdmin}, SuperAdmin: ${isSuperAdmin}`);

                // Obtener informaci�n completa del contacto
                let phoneNumber = '';
                let contactName = '';
                let notifyName = '';
                let avatarUrl = '';

                // Procesar contactos de WhatsApp
                // Pueden tener formato: @s.whatsapp.net, @g.us, o @lid (Local ID)
                if (contactJid.includes('@s.whatsapp.net') || contactJid.includes('@g.us') || contactJid.includes('@lid')) {
                    console.log(`[GROUPS-SYNC] ?? Tipo de JID detectado: ${contactJid.split('@')[1]}`);

                    // Extraer n�mero de WhatsApp del JID usando helper function
                    if (contactJid.includes('@s.whatsapp.net')) {
                        // Contacto normal de WhatsApp - extraer n�mero real
                        phoneNumber = extractPhoneNumber(contactJid);
                        console.log(`[GROUPS-SYNC] ?? N�mero extra�do de @s.whatsapp.net: ${phoneNumber}`);
                    } else if (contactJid.includes('@lid')) {
                        // Local ID - NO tiene n�mero de tel�fono real
                        console.log(`[GROUPS-SYNC] ?? @lid detectado - ID interno de privacidad`);

                        // NO guardar el ID como n�mero de tel�fono - es un ID interno, no un n�mero real
                        phoneNumber = null;

                        // Generar nombre gen�rico usando el ID
                        const internalId = contactJid.split('@')[0];
                        contactName = `Privado ${internalId.substring(0, 8)}`;
                        notifyName = 'Privado';

                        console.log(`[GROUPS-SYNC] ?? Phone number: null (privado)`);
                        console.log(`[GROUPS-SYNC] ?? Nombre generado: ${contactName}`);
                        console.log(`[GROUPS-SYNC] ?? LIMITACI�N: @lid no contiene el n�mero real de tel�fono`);
                    } else if (contactJid.includes('@g.us')) {
                        // Participante de grupo - extraer n�mero real
                        const tempNumber = contactJid.split('@')[0];
                        if (tempNumber) {
                            phoneNumber = tempNumber;
                        }
                        console.log(`[GROUPS-SYNC] ?? N�mero extra�do de @g.us: ${phoneNumber}`);
                    }

                    // Convertir a formato Paraguay si es necesario (solo si phoneNumber no es null)
                    if (phoneNumber) {
                        if (phoneNumber.startsWith('+')) {
                            phoneNumber = phoneNumber.replace('+', '');
                        }
                        if (phoneNumber.startsWith('595')) {
                            phoneNumber = phoneNumber.replace('595', '0');
                        }

                        // Verificar si es un n�mero v�lido (no demasiado largo)
                        if (phoneNumber.length > 15) {
                            console.log(`[GROUPS-SYNC] ??  N�mero sospechoso (muy largo): ${phoneNumber}`);
                            phoneNumber = null; // No guardar n�meros inv�lidos
                        }
                    }
                    
                    // Intentar obtener informaci�n del contacto desde WhatsApp
                    try {
                        if (sock) {
                            let targetJid = contactJid;

                            // Para @lid, NO intentar obtener info de WhatsApp (el JID no es v�lido para consultas)
                            if (contactJid.includes('@lid')) {
                                console.log(`[GROUPS-SYNC] ?? Saltando fetch para @lid - usando datos del participante`);

                                // Intentar obtener nombre del objeto participant si existe
                                if (participant.verifiedName) {
                                    contactName = participant.verifiedName;
                                    console.log(`[GROUPS-SYNC] ?? Nombre de verifiedName: ${contactName}`);
                                } else if (participant.pushName) {
                                    contactName = participant.pushName;
                                    console.log(`[GROUPS-SYNC] ?? Nombre de pushName: ${contactName}`);
                                }

                                // No obtener avatar para @lid (el JID no es v�lido)
                                console.log(`[GROUPS-SYNC] ?? Avatar no disponible para @lid`);

                                // Saltear el resto del proceso de fetch
                                throw new Error('SKIP_FETCH_FOR_LID');
                            }

                            // Si es un JID de grupo, intentar obtener el JID real
                            if (contactJid.includes('@g.us')) {
                                // Para participantes de grupo, intentar obtener el JID real
                                // Esto puede requerir una b�squeda adicional
                                try {
                                    // Obtener metadata del grupo para identificar participantes reales
                                    const groupMetadata = await sock.groupMetadata(normalizedGroupJid);
                                    if (groupMetadata && groupMetadata.participants) {
                                        // Buscar el participante real en la metadata del grupo
                                        const realParticipant = groupMetadata.participants.find(p =>
                                            p.id.includes(contactJid.split('@')[0])
                                        );
                                        if (realParticipant) {
                                            targetJid = realParticipant.id;
                                        } else {
                                            // Si no se encuentra, intentar construir el JID real
                                            const participantId = contactJid.split('@')[0];
                                            const realJid = `${participantId}@s.whatsapp.net`;
                                            // Verificar si este JID real existe
                                            try {
                                                const contactInfo = await sock.fetchContacts([realJid]);
                                                if (contactInfo && contactInfo.length > 0) {
                                                    targetJid = realJid;
                                                }
                                            } catch (verifyError) {
                                                // Si no se puede verificar, continuar con el JID original
                                                targetJid = contactJid;
                                            }
                                        }
                                    }
                                } catch (metaError) {
                                    console.log(`[GROUPS-SYNC] ??  No se pudo obtener metadata para grupo ${normalizedGroupJid}:`, metaError.message);
                                    // Continuar con el JID original
                                    targetJid = contactJid;
                                }
                            }
                            
                            // Obtener informaci�n del contacto usando la misma l�gica que en contacts
                            const contactInfo = await sock.fetchContacts([targetJid]);
                            if (contactInfo && contactInfo.length > 0) {
                                const contact = contactInfo[0];
                                contactName = contact.name || contact.notify || '';
                                notifyName = contact.notify || '';
                                
                                console.log(`[GROUPS-SYNC] ? Informaci�n de contacto obtenida: ${contactName || notifyName}`);
                                
                                // Obtener foto de perfil usando la misma l�gica que funciona en contacts
                                try {
                                    const profilePic = await sock.profilePictureUrl(targetJid, 'image').catch(() => null);
                                    if (profilePic) {
                                        avatarUrl = profilePic;
                                        console.log(`[GROUPS-SYNC] ?? Avatar obtenido para ${targetJid}`);
                                    }
                                } catch (picError) {
                                    // Si no hay foto, continuar sin ella
                                    console.log(`[GROUPS-SYNC] ??  No se pudo obtener avatar para ${targetJid}:`, picError.message);
                                }
                            } else {
                                console.log(`[GROUPS-SYNC] ??  No se encontr� informaci�n para ${targetJid}`);
                            }
                        }
                    } catch (contactError) {
                        if (contactError.message !== 'SKIP_FETCH_FOR_LID') {
                            console.log(`[GROUPS-SYNC] ??  No se pudo obtener informaci�n para ${contactJid}:`, contactError.message);
                        }
                    }

                    // Si no se obtuvo nombre del contacto, usar el n�mero como referencia
                    if (!contactName && !notifyName) {
                        if (phoneNumber) {
                            contactName = `Usuario ${phoneNumber}`;
                            notifyName = phoneNumber;
                        } else {
                            // Si tampoco hay n�mero, usar el JID
                            contactName = `Usuario ${contactJid.split('@')[0]}`;
                            notifyName = contactJid.split('@')[0];
                        }
                        console.log(`[GROUPS-SYNC] ?? Nombre generado autom�ticamente: ${contactName}`);
                    }

                    console.log(`[GROUPS-SYNC] ?? Miembro: ${contactName || notifyName || 'Sin nombre'} | Tel: ${phoneNumber || 'N/A'} | Admin: ${isAdmin}`);

                    // Obtener el n�mero de tel�fono del usuario conectado para usarlo como session_id
                    const userPhoneNumber = await getUserPhoneNumber(sessionId);
                    
                    console.log(`[GROUPS-SYNC] ?? Intentando guardar en BD - Tabla: contact_group_members`);
                    console.log(`[GROUPS-SYNC] ?? Datos: contact_jid=${contactJid}, group_jid=${normalizedGroupJid}, name=${contactName}`);

                    // IMPORTANTE: Orden de columnas seg�n estructura real de la tabla:
                    // id, contact_jid, group_jid, is_admin, is_super_admin, phone_number,
                    // name, notify_name, avatar_url, user_session_id, created_at, updated_at, session_id
                    const sqlQuery = `INSERT INTO contact_group_members (
                            contact_jid, group_jid, is_admin, is_super_admin,
                            phone_number, name, notify_name, avatar_url,
                            user_session_id, session_id
                        ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
                        ON DUPLICATE KEY UPDATE
                            is_admin = VALUES(is_admin),
                            is_super_admin = VALUES(is_super_admin),
                            phone_number = VALUES(phone_number),
                            name = VALUES(name),
                            notify_name = VALUES(notify_name),
                            avatar_url = VALUES(avatar_url),
                            user_session_id = VALUES(user_session_id),
                            session_id = VALUES(session_id),
                            updated_at = NOW()`;

                    const sqlParams = [
                        contactJid,           // contact_jid
                        normalizedGroupJid,   // group_jid
                        isAdmin,              // is_admin
                        isSuperAdmin,         // is_super_admin
                        phoneNumber,          // phone_number
                        contactName,          // name
                        notifyName,           // notify_name
                        avatarUrl,            // avatar_url
                        userSessionId,        // user_session_id
                        userPhoneNumber       // session_id
                    ];

                    console.log(`[GROUPS-SYNC] ?? SQL Query preparada`);
                    console.log(`[GROUPS-SYNC] ?? Params:`, JSON.stringify(sqlParams));

                    // Insertar o actualizar miembro del grupo
                    console.log(`[GROUPS-SYNC] ? Ejecutando INSERT/UPDATE...`);
                    const [result] = await connection.execute(sqlQuery, sqlParams);
                    console.log(`[GROUPS-SYNC] ? Query ejecutada, procesando resultado...`);

                    console.log(`[GROUPS-SYNC] ? GUARDADO EN BD! ID: ${result.insertId || 'actualizado'}, affectedRows: ${result.affectedRows}, warningCount: ${result.warningCount}`);

                    membersSaved++;
                } else {
                    // Este participante no tiene un formato reconocido
                    console.log(`[GROUPS-SYNC] ?? Participante con formato no reconocido (no es @s.whatsapp.net, @g.us, ni @lid): ${contactJid}`);
                    console.log(`[GROUPS-SYNC] ?? Este participante NO se guardar� en la base de datos`);
                }

            } catch (memberError) {
                console.error(`[GROUPS-SYNC] ??? ERROR CR�TICO guardando miembro ${participant.id} del grupo ${groupId}:`);
                console.error(`[GROUPS-SYNC] ? Error completo:`, memberError);
                console.error(`[GROUPS-SYNC] ? Stack trace:`, memberError.stack);
                console.error(`[GROUPS-SYNC] ? Error message:`, memberError.message);
                console.error(`[GROUPS-SYNC] ? Error code:`, memberError.code);
                console.error(`[GROUPS-SYNC] ? SQL State:`, memberError.sqlState);
                console.error(`[GROUPS-SYNC] ? SQL Message:`, memberError.sqlMessage);
            }
        }

        console.log(`[GROUPS-SYNC] ? Guardados ${membersSaved} miembros del grupo ${groupId}`);
        return membersSaved;

    } catch (generalError) {
        console.error(`[GROUPS-SYNC] ??? ERROR GENERAL en saveGroupMembersToDatabase:`, generalError);
        console.error(`[GROUPS-SYNC] ? Stack:`, generalError.stack);
        return 0;
    } finally {
        if (connection) {
            console.log(`[GROUPS-SYNC] ?? Liberando conexi�n...`);
            connection.release();
            console.log(`[GROUPS-SYNC] ? Conexi�n liberada`);
        }
    }
}

/**
 * Funci�n para sincronizar miembros de grupos desde la tabla contacts
 * Esta es una SOLUCI�N ALTERNATIVA cuando los participantes vienen con formato @lid
 * y no se pueden obtener desde los mensajes.
 *
 * IMPORTANTE: Esta funci�n agrega TODOS los contactos a TODOS los grupos.
 * Es un workaround porque no podemos saber qu� contacto pertenece a qu� grupo con @lid.
 */
async function syncGroupMembersFromContacts(sessionId) {
    if (!pool) {
        console.log(`[SYNC-MEMBERS] ? No hay conexi�n a base de datos`);
        return { success: false, error: 'No database connection' };
    }

    let connection;
    try {
        console.log(`[SYNC-MEMBERS] ?? Iniciando sincronizaci�n de miembros desde tabla contacts`);

        connection = await pool.getConnection();

        // Obtener el user_session_id
        const phoneNumber = await getUserPhoneNumber(sessionId);
        const [userSessionRows] = await connection.execute(
            'SELECT id FROM user_sessions WHERE phone_number = ? LIMIT 1',
            [phoneNumber]
        );

        if (userSessionRows.length === 0) {
            throw new Error('No se encontr� user_session_id');
        }

        const userSessionId = userSessionRows[0].id;

        // 1. Obtener todos los contactos (solo personas, no grupos)
        const [contacts] = await connection.execute(
            `SELECT jid, name, notify_name, avatar_url
             FROM contacts
             WHERE session_id = ?
               AND is_group = 0
               AND jid LIKE '%@s.whatsapp.net'`,
            [phoneNumber]
        );

        console.log(`[SYNC-MEMBERS] ?? Encontrados ${contacts.length} contactos`);

        // 2. Obtener todos los grupos
        const [groups] = await connection.execute(
            `SELECT jid, name
             FROM contact_groups
             WHERE session_id = ?`,
            [phoneNumber]
        );

        console.log(`[SYNC-MEMBERS] ?? Encontrados ${groups.length} grupos`);

        if (contacts.length === 0 || groups.length === 0) {
            console.log(`[SYNC-MEMBERS] ?? No hay suficientes datos para sincronizar`);
            return { success: false, error: 'Not enough data' };
        }

        let membersAdded = 0;
        let membersSkipped = 0;

        // 3. Para cada grupo, agregar contactos como miembros
        for (const group of groups) {
            console.log(`[SYNC-MEMBERS] ?? Procesando grupo: ${group.name}`);

            for (const contact of contacts) {
                try {
                    const phoneNum = extractPhoneNumber(contact.jid);

                    if (!phoneNum) {
                        membersSkipped++;
                        continue;
                    }

                    // Intentar insertar el miembro (ignorar si ya existe)
                    await connection.execute(
                        `INSERT INTO contact_group_members (
                            contact_jid, group_jid, is_admin, is_super_admin,
                            phone_number, name, notify_name, avatar_url,
                            user_session_id, session_id
                        ) VALUES (?, ?, 0, 0, ?, ?, ?, ?, ?, ?)
                        ON DUPLICATE KEY UPDATE
                            name = VALUES(name),
                            notify_name = VALUES(notify_name),
                            avatar_url = VALUES(avatar_url),
                            updated_at = NOW()`,
                        [
                            contact.jid,
                            group.jid,
                            phoneNum,
                            contact.name,
                            contact.notify_name,
                            contact.avatar_url,
                            userSessionId,
                            phoneNumber
                        ]
                    );

                    membersAdded++;

                } catch (err) {
                    // Ignorar errores de duplicados
                    if (err.code !== 'ER_DUP_ENTRY') {
                        console.error(`[SYNC-MEMBERS] ?? Error agregando ${contact.name} a ${group.name}:`, err.message);
                    }
                    membersSkipped++;
                }
            }
        }

        console.log(`[SYNC-MEMBERS] ? Sincronizaci�n completada`);
        console.log(`[SYNC-MEMBERS] ?? Miembros agregados: ${membersAdded}`);
        console.log(`[SYNC-MEMBERS] ??  Miembros saltados: ${membersSkipped}`);

        return {
            success: true,
            membersAdded,
            membersSkipped,
            totalContacts: contacts.length,
            totalGroups: groups.length
        };

    } catch (error) {
        console.error(`[SYNC-MEMBERS] ? Error en sincronizaci�n:`, error);
        return { success: false, error: error.message };
    } finally {
        if (connection) {
            connection.release();
        }
    }
}

// Funci�n para sincronizar el historial completo de WhatsApp
// NOTA: En Baileys, la sincronizaci�n es AUTOM�TICA v�a eventos
// Los eventos chats.set, contacts.set y messages.upsert hacen el trabajo real
// Esta funci�n solo registra que la sincronizaci�n est� lista
async function syncHistoricalData(sessionId, sock, userSessionId) {
    console.log(`[SYNC] ?? Registrando sincronizaci�n para sessionId: ${sessionId}, user_session_id: ${userSessionId}`);
    console.log(`[SYNC] ??  Los datos se descargar�n autom�ticamente v�a eventos de Baileys`);
    console.log(`[SYNC] ??  Escuchando: chats.set, contacts.set, messages.upsert`);

    const stats = {
        chatsProcessed: 0,
        contactsSaved: 0,
        messagesDownloaded: 0,
        groupsSaved: 0,
        membersSaved: 0,
        errors: 0,
        startTime: Date.now(),
        totalTime: 0
    };

    // Emitir que estamos listos para recibir datos
    io.emit(`sync-progress-${sessionId}`, {
        stage: 'waiting_for_data',
        message: 'Esperando datos de WhatsApp...',
        ...stats
    });

    // SINCRONIZAR GRUPOS Y MIEMBROS INMEDIATAMENTE
    try {
        console.log(`[SYNC] ?? Iniciando sincronizaci�n autom�tica de grupos...`);
        const groupsStats = await syncGroupsAndMembers(sessionId, sock, userSessionId);
        stats.groupsSaved = groupsStats.groupsSaved;
        stats.membersSaved = groupsStats.membersSaved;
        console.log(`[SYNC] ? Sincronizaci�n de grupos completada: ${groupsStats.groupsSaved} grupos, ${groupsStats.membersSaved} miembros`);
    } catch (groupsError) {
        console.error(`[SYNC] ? Error en sincronizaci�n de grupos:`, groupsError);
        stats.errors++;
    }

    console.log(`[SYNC] ? Sistema de sincronizaci�n listo`);
    console.log(`[SYNC] ?? Los chats, contactos y mensajes se guardar�n cuando WhatsApp los env�e\n`);

    return stats;
}

// Helper function to load chat list from DB
async function loadChatListFromDB(sessionId) {
    // Obtener el n�mero de tel�fono del usuario en lugar de la session_id temporal
    const phoneNumber = await getUserPhoneNumber(sessionId);
    
    // Modo memoria si no hay DB
    if (process.env.SKIP_DB === 'true' || !pool || memoryStorage.isMemoryMode) {
        console.log(`[MEMORY-CHATLIST] Loading chats from memory for phone number ${phoneNumber}`);
        const chats = [];
        const chatMap = new Map();

        // Procesar mensajes en memoria para crear lista de chats (filtrar por n�mero de tel�fono como session_id)
        for (const [messageKey, message] of memoryStorage.messages) {
            if (message.session_id === phoneNumber) {
                const chatJid = message.chat_jid;
                if (!chatMap.has(chatJid) || new Date(message.timestamp) > new Date(chatMap.get(chatJid).timestamp)) {
                    const contact = memoryStorage.contacts.get(chatJid);
                    chatMap.set(chatJid, {
                        id: chatJid,
                        name: contact?.name || chatJid.split('@')[0],
                        isGroup: contact?.is_group || false,
                        lastMessage: message.text_content,
                        timestamp: new Date(message.timestamp).toISOString(),
                        fromMe: message.from_me,
                        status: message.status,
                        unreadCount: 0,
                        avatar: null
                    });
                }
            }
        }

        const chatList = Array.from(chatMap.values()).sort((a, b) =>
            new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()
        );

        console.log(`[MEMORY-CHATLIST] Loaded ${chatList.length} chats from memory for phone number ${phoneNumber}`);
        return chatList;
    }

    if (!pool) {
        console.error('[DB-CHATLIST] DB Pool not initialized!');
        return [];
    }

    const connection = await pool.getConnection();
    try {
        console.log(`[DB-CHATLIST] Loading chat list for phone number ${phoneNumber}`);

        // Query modificada para filtrar por session_id (que ahora contiene el n�mero de tel�fono)
        const [rows] = await connection.execute(
            `SELECT
                m.chat_jid,
                c.name AS contact_name,
                c.notify_name AS contact_notify_name,
                c.is_group,
                m.text_content AS last_message_text,
                m.timestamp AS last_message_timestamp,
                m.from_me AS last_message_from_me,
                m.status AS last_message_status,
                (SELECT COUNT(*) FROM messages unread
                 WHERE unread.chat_jid = m.chat_jid
                 AND unread.session_id = m.session_id
                 AND unread.from_me = FALSE
                 AND unread.is_read = FALSE) AS unread_count
            FROM messages m
            JOIN (
                SELECT chat_jid, MAX(timestamp) AS max_timestamp
                FROM messages
                WHERE session_id = ?
                GROUP BY chat_jid
            ) latest_msg ON m.chat_jid = latest_msg.chat_jid AND m.timestamp = latest_msg.max_timestamp
            LEFT JOIN contacts c ON m.chat_jid = c.jid
            WHERE m.session_id = ?
            ORDER BY m.timestamp DESC;`,
            [phoneNumber, phoneNumber]
        );

        const chatList = rows.map(row => ({
            id: row.chat_jid,
            name: row.contact_name || row.contact_notify_name || row.chat_jid.split('@')[0],
            isGroup: !!row.is_group,
            lastMessage: row.last_message_text,
            timestamp: new Date(row.last_message_timestamp).toISOString(),
            fromMe: !!row.last_message_from_me,
            status: row.last_message_status,
            unreadCount: row.unread_count || 0,
            avatar: null // Placeholder for avatar
        }));

        console.log(`[DB-CHATLIST] Loaded ${chatList.length} chats for phone number ${phoneNumber}`);
        return chatList;

    } catch (error) {
        console.error(`[DB-CHATLIST] Error loading chat list for session ${sessionId}:`, error);
        return [];
    } finally {
        if (connection) connection.release();
    }
}

// const messageStore = new Map(); // <-- Comentado para transicionar a DB

// Helper function to check if a session is active and connected
function isSessionActive(sessionId) {
    const session = sessions.get(sessionId);
    if (!session || !session.isConnected || !session.sock) {
        return false;
    }
    return true;
}

// Funci�n para crear una nueva sesi�n de WhatsApp
const createSession = async (sessionId, forceNew = false) => {
    // Si ya existe una sesi�n activa y no se fuerza una nueva, retornarla
    const existingSession = sessions.get(sessionId);
    if (existingSession && !forceNew) {
        return existingSession;
    }

    // Si hay un QR reciente v�lido, usar ese
    if (lastQRSession && !lastQRSession.session.isConnected && !forceNew) {
        const timeSinceCreation = Date.now() - lastQRSession.createdAt;
        if (timeSinceCreation < QR_EXPIRY_TIME) {
            return lastQRSession.session;
        }
    }

    const AUTH_DIR = path.join(BASE_AUTH_DIR, sessionId);
    if (!fs.existsSync(AUTH_DIR)) {
        fs.mkdirSync(AUTH_DIR, { recursive: true });
    }

    try {
        const { version } = await fetchLatestBaileysVersion();
        const { state, saveCreds } = await useMultiFileAuthState(AUTH_DIR);

        // Crear almac�n personalizado para chats y contactos
        const customStore = {
            contacts: new Map(),
            chats: new Map()
        };

        const sock = makeWASocket({
            version,
            auth: state,
            printQRInTerminal: false,
            logger: pino({ level: 'silent' }),
            browser: ['Ubuntu', 'Chrome', '20.0.04'],
            syncFullHistory: true,
            shouldSyncHistoryMessage: () => true,
            getMessage: async (key) => {
                return { conversation: 'Message not available' };
            }
        });

        const sessionInfo = {
            sock,
            store: customStore,
            qr: null,
            isConnected: false,
            createdAt: Date.now(),
            messages: [],
            chats: [],
            hasSynced: false,  // ? Flag para evitar re-sincronizaciones
            lastSyncTimestamp: null
        };

        // Manejar actualizaciones de conexi�n
        sock.ev.on('connection.update', async (update) => {
            const { connection, lastDisconnect, qr } = update;

            if (qr) {
                sessionInfo.qr = qr;
                sessionInfo.isConnected = false;
                lastQRSession = {
                    session: sessionInfo,
                    createdAt: Date.now()
                };
                console.log(`[${sessionId}] Nuevo c�digo QR generado`);

                // Convertir QR a Data URL
                QRCode.toDataURL(qr, {
                    width: 300,
                    margin: 1,
                    errorCorrectionLevel: 'H'
                }).then(qrDataUrl => {
                    // Emitir evento global para que el frontend lo reciba
                    io.emit('qr-code', { qrDataUrl, sessionId });
                    // Tambi�n emitir evento espec�fico por sesi�n
                    io.emit(`qr-${sessionId}`, { qr, qrDataUrl, sessionId });
                    console.log(`[${sessionId}] QR emitido globalmente y a sesi�n espec�fica`);
                }).catch(err => {
                    console.error(`[${sessionId}] Error generando QR DataURL:`, err);
                });
            }

            if (connection === 'open') {
                sessionInfo.isConnected = true;
                sessionInfo.qr = null;
                console.log(`[${sessionId}] �WhatsApp conectado exitosamente!`);

                // Registrar el n�mero de tel�fono del usuario en la base de datos
                let userSessionId = null;
                try {
                    const userPhoneNumber = await getUserPhoneNumber(sessionId);
                    if (userPhoneNumber) {
                        userSessionId = await getOrCreateUserSession(sessionId, userPhoneNumber);
                        console.log(`[${sessionId}] Usuario registrado: ${userPhoneNumber} (user_session_id: ${userSessionId})`);

                        // Crear tableros Kanban por defecto si es la primera vez
                        await createDefaultKanbanBoards(userPhoneNumber);
                    }
                } catch (error) {
                    console.error(`[${sessionId}] Error registrando usuario:`, error);
                }

                io.emit('connection-update', {
                    status: 'connected',
                    sessionId: sessionId,
                    timestamp: new Date().toISOString()
                });
                io.emit(`connection-${sessionId}`, { status: 'connected' });

                // SINCRONIZACI�N AUTOM�TICA DEL HISTORIAL COMPLETO
                // ? SOLO sincronizar si NO se ha sincronizado antes
                if (userSessionId && !sessionInfo.hasSynced) {
                    console.log(`[${sessionId}] ?? Iniciando sincronizaci�n autom�tica del historial (primera vez)...`);
                    sessionInfo.hasSynced = true;  // Marcar como sincronizado
                    sessionInfo.lastSyncTimestamp = Date.now();

                    // Ejecutar sincronizaci�n en background (no bloquear)
                    syncHistoricalData(sessionId, sock, userSessionId).then(stats => {
                        console.log(`[${sessionId}] ? Sincronizaci�n completada con �xito:`, stats);

                        // Despu�s de sincronizar, cargar y emitir la lista de chats actualizada
                        return loadChatListFromDB(sessionId);
                    }).then(initialChats => {
                        // Emitir GLOBALMENTE para que el cliente que escucha este evento lo reciba
                        io.emit(`initial-chats-${sessionId}`, { chats: initialChats });
                        console.log(`[${sessionId}] Emitted initial chat list GLOBALLY for event initial-chats-${sessionId} with ${initialChats.length} chats.`);
                    }).catch(syncError => {
                        console.error(`[${sessionId}] ? Error en sincronizaci�n autom�tica:`, syncError);
                        sessionInfo.hasSynced = false;  // ? Resetear flag si falla

                        // Aunque falle la sincronizaci�n, intentar cargar chats existentes de la BD
                        loadChatListFromDB(sessionId).then(initialChats => {
                            io.emit(`initial-chats-${sessionId}`, { chats: initialChats });
                            console.log(`[${sessionId}] Emitted chat list from DB (fallback) with ${initialChats.length} chats.`);
                        }).catch(e => {
                            console.error(`[${sessionId}] Error loading chats from DB:`, e);
                        });
                    });
                } else if (userSessionId && sessionInfo.hasSynced) {
                    console.log(`[${sessionId}] ??  Sincronizaci�n ya realizada anteriormente, solo cargando chats de BD...`);
                    // Si ya se sincroniz�, solo cargar chats existentes
                    try {
                        const initialChats = await loadChatListFromDB(sessionId);
                        io.emit(`initial-chats-${sessionId}`, { chats: initialChats });
                        console.log(`[${sessionId}] Emitted chat list with ${initialChats.length} chats (ya sincronizado).`);
                    } catch (e) {
                        console.error(`[${sessionId}] Error loading chat list:`, e);
                    }
                } else {
                    // Si no hay userSessionId, solo cargar chats existentes
                    try {
                        const initialChats = await loadChatListFromDB(sessionId);
                        io.emit(`initial-chats-${sessionId}`, { chats: initialChats });
                        console.log(`[${sessionId}] Emitted initial chat list with ${initialChats.length} chats (no sync).`);
                    } catch (e) {
                        console.error(`[${sessionId}] Error loading or emitting initial chat list:`, e);
                    }
                }

                // La carga de contactos a trav�s de sock.getContacts() o customStore se reemplaza/complementa
                // con getOrInsertContact en messages.upsert y contacts.update
            }

            if (connection === 'close') {
                sessionInfo.isConnected = false;
                const shouldReconnect = lastDisconnect?.error?.output?.statusCode !== DisconnectReason.loggedOut;

                console.log(`[${sessionId}] ? Conexi�n cerrada. shouldReconnect: ${shouldReconnect}, statusCode: ${lastDisconnect?.error?.output?.statusCode}`);

                // ? Emitir evento global de desconexi�n
                io.emit('connection-update', {
                    status: 'disconnected',
                    sessionId: sessionId,
                    timestamp: new Date().toISOString()
                });
                io.emit(`connection-${sessionId}`, { status: 'disconnected' });

                // Get phone number to deactivate session in DB
                const userPhoneNumber = await getUserPhoneNumber(sessionId);

                if (shouldReconnect) {
                    console.log(`[${sessionId}] ??  Desconexi�n temporal, intentando reconectar...`);
                    // NO eliminar la sesi�n a�n si va a reconectar
                    // sessions.delete(sessionId);
                    setTimeout(() => createSession(sessionId, true), 3000);
                } else {
                    console.log(`[${sessionId}] ?? Usuario desconectado (logged out) - LIMPIANDO SESI�N`);

                    // ? LIMPIAR COMPLETAMENTE la sesi�n
                    sessions.delete(sessionId);

                    // Deactivate the session in the DB
                    if (userPhoneNumber) {
                        await deactivateUserSession(userPhoneNumber);
                        console.log(`[${sessionId}] ? Sesi�n desactivada en BD para ${userPhoneNumber}`);
                    }

                    // ? Emitir evento para que el frontend redirija al login
                    io.emit('whatsapp-disconnected', {
                        sessionId: sessionId,
                        phoneNumber: userPhoneNumber,
                        timestamp: new Date().toISOString()
                    });
                }
            }
        });

        // Manejar mensajes entrantes
        sock.ev.on('messages.upsert', async (m) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando ${m.messages.length} mensajes`);
                return;
            }

            // Procesar TODOS los tipos de mensajes: 'notify', 'append', 'prepend'
            // 'notify' = nuevos mensajes en tiempo real
            // 'append' = mensajes hist�ricos al conectar
            // 'prepend' = mensajes m�s antiguos
            console.log(`[${sessionId}] Procesando ${m.messages.length} mensajes tipo: ${m.type}`);

            if (m.type === 'notify' || m.type === 'append' || m.type === 'prepend') {
                for (const msg of m.messages) {
                    const senderJid = msg.key.remoteJid; 
                    const participantJid = msg.key.participant; 
                    const messageId = msg.key.id;
                    let pushName = msg.pushName; // Puede ser el nombre del contacto o el asunto del grupo

                    // 1. Guardar/Actualizar Contacto/Grupo en la DB
                    if (senderJid) { // Solo proceder si senderJid est� definido
                        const isGroup = senderJid.includes('@g.us');
                         // Para grupos, msg.pushName es el subject. Para contactos, es el pushName.
                        let contactNameForDb = isGroup ? null : pushName; 
                        let notifyNameForDb = pushName;

                        if(isGroup && msg.messageStubType) { // Si es un mensaje de sistema de grupo (ej. alguien se uni�)
                           // El pushName podr�a no ser relevante o ser el nombre del grupo.
                           // A menudo no hay un 'nombre' real para estos, solo el JID del grupo.
                           contactNameForDb = null; // El nombre del grupo se obtiene de groupMetadata o chats.update
                           notifyNameForDb = null; // 
                        }
                        
                        // Obtener el n�mero de tel�fono del usuario de la sesi�n
                        const phoneNumber = await getUserPhoneNumber(sessionId);
                        await getOrInsertContact(senderJid, contactNameForDb, notifyNameForDb, isGroup, phoneNumber);
                        
                        if (isGroup && participantJid) {
                            // msg.pushName aqu� es el del remitente del mensaje, no el nombre del grupo.
                            // Si necesitamos el nombre del grupo, ser�a de un evento 'chats.update' o 'group-metadata'
                            await getOrInsertContact(participantJid, msg.pushName, msg.pushName, false, phoneNumber);

                            // DEBUG: Ver formato del participantJid
                            console.log(`[${sessionId}] ?? DEBUG: participantJid = ${participantJid}`);
                            console.log(`[${sessionId}] ?? DEBUG: msg.pushName = ${msg.pushName}`);
                            console.log(`[${sessionId}] ?? DEBUG: senderJid (grupo) = ${senderJid}`);

                            // AGREGAR: Guardar como miembro del grupo autom�ticamente
                            try {
                                const userSessionId = await getUserSessionId(sessionId);

                                // DEBUG: Ver si cumple condici�n
                                console.log(`[${sessionId}] ?? DEBUG: �Tiene @s.whatsapp.net? ${participantJid.includes('@s.whatsapp.net')}`);
                                console.log(`[${sessionId}] ?? DEBUG: userSessionId = ${userSessionId}, pool = ${!!pool}`);

                                if (userSessionId && pool && participantJid.includes('@s.whatsapp.net')) {
                                    const connection = await pool.getConnection();
                                    try {
                                        // Obtener datos del contacto
                                        const [contactData] = await connection.execute(
                                            'SELECT jid, name, notify_name, avatar_url FROM contacts WHERE jid = ? AND session_id = ? LIMIT 1',
                                            [participantJid, phoneNumber]
                                        );

                                        if (contactData.length > 0) {
                                            const contact = contactData[0];
                                            const phoneNum = extractPhoneNumber(participantJid);

                                            // Insertar como miembro del grupo si no existe
                                            await connection.execute(
                                                `INSERT INTO contact_group_members (
                                                    contact_jid, group_jid, is_admin, is_super_admin,
                                                    phone_number, name, notify_name, avatar_url,
                                                    user_session_id, session_id
                                                ) VALUES (?, ?, 0, 0, ?, ?, ?, ?, ?, ?)
                                                ON DUPLICATE KEY UPDATE
                                                    name = VALUES(name),
                                                    notify_name = VALUES(notify_name),
                                                    avatar_url = VALUES(avatar_url),
                                                    updated_at = NOW()`,
                                                [
                                                    participantJid,
                                                    senderJid,
                                                    phoneNum,
                                                    contact.name,
                                                    contact.notify_name,
                                                    contact.avatar_url,
                                                    userSessionId,
                                                    phoneNumber
                                                ]
                                            );
                                            console.log(`[${sessionId}] ?? Miembro agregado al grupo: ${contact.name || participantJid}`);
                                        }
                                    } finally {
                                        connection.release();
                                    }
                                }
                            } catch (memberError) {
                                console.error(`[${sessionId}] Error agregando miembro al grupo:`, memberError.message);
                            }
                        }
                    }
                    
                    // 2. Procesar y guardar mensaje en la DB
                    // Solo procesar mensajes con contenido visible o de sistema que queramos registrar
                    if (msg.message && messageId) { 
                        const messageType = Object.keys(msg.message)[0] || 'unknown';
                        let textContent = msg.message?.conversation || msg.message?.extendedTextMessage?.text;
                        let mediaUrl = null; // Placeholder
                        let mediaMimeType = null;

                        if (messageType === 'imageMessage' && msg.message.imageMessage) {
                            textContent = msg.message.imageMessage.caption || '';
                            mediaMimeType = msg.message.imageMessage.mimetype;
                            try {
                                // Descargar y procesar la imagen
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando imagen:`, error.message);
                                // Usar URL remota si la descarga local falla
                                mediaUrl = null; // Por ahora, podr�a ser la URL remota
                            }
                        } else if (messageType === 'videoMessage' && msg.message.videoMessage) {
                            textContent = msg.message.videoMessage.caption || '';
                            mediaMimeType = msg.message.videoMessage.mimetype;
                            try {
                                // Descargar y procesar el video
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando video:`, error.message);
                                mediaUrl = null;
                            }
                        } else if (messageType === 'audioMessage' && msg.message.audioMessage) {
                            textContent = ''; // Audio no suele tener text_content
                            mediaMimeType = msg.message.audioMessage.mimetype;
                            try {
                                // Descargar y procesar el audio
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando audio:`, error.message);
                                mediaUrl = null;
                            }
                        } else if (messageType === 'documentMessage' && msg.message.documentMessage) {
                            textContent = msg.message.documentMessage.title || msg.message.documentMessage.fileName || 'Document';
                            mediaMimeType = msg.message.documentMessage.mimetype;
                            try {
                                // Descargar y procesar el documento
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando documento:`, error.message);
                                mediaUrl = null;
                            }
                        } else if (messageType === 'protocolMessage' || messageType === 'senderKeyDistributionMessage' || messageType === 'deviceSentMessage') {
                            // Ignorar estos tipos de mensajes o manejarlos espec�ficamente si es necesario
                            console.log(`[${sessionId}] Ignoring protocol/device message type: ${messageType}`);
                            continue; 
                        } else if (!textContent && !mediaMimeType && messageType !== 'reactionMessage') { // No guardar mensajes vac�os sin media, a menos que sea una reacci�n.
                             if(Object.keys(msg.message).length === 0) { // Mensaje realmente vac�o
                                console.log(`[${sessionId}] Ignoring empty message (no content, no media) with ID ${messageId}`);
                                continue;
                             }
                        }


                        const ownJid = sessionInfo.sock?.user?.id?.replace(/:.*$/, '') + '@s.whatsapp.net';
                        const finalSenderJid = msg.key.fromMe ? ownJid : (participantJid || senderJid);
                        
                        const dbMessage = {
                            id: messageId,
                            chat_jid: senderJid, // El JID de la conversaci�n
                            sender_jid: finalSenderJid, // El JID real del que envi�
                            from_me: msg.key.fromMe,
                            message_type: messageType,
                            text_content: textContent,
                            media_url: mediaUrl, 
                            media_mime_type: mediaMimeType,
                            timestamp: msg.messageTimestamp ? new Date(Number(msg.messageTimestamp) * 1000) : new Date(),
                            status: msg.key.fromMe ? 'sent' : 'received' // Estado inicial
                        };

                        await saveMessageToDB(sessionId, dbMessage);
                        
                        // Emitir al cliente v�a Socket.IO
                        if (!msg.key.fromMe) { // Solo emitir mensajes entrantes (salientes se emiten desde el endpoint)
                             const clientMessage = {
                                id: dbMessage.id,
                                from: dbMessage.sender_jid, 
                                message: dbMessage.text_content,
                                timestamp: dbMessage.timestamp.toISOString(),
                                type: dbMessage.message_type,
                                mediaUrl: dbMessage.media_url,
                                mediaMimeType: dbMessage.media_mime_type,
                                status: dbMessage.status,
                                chatJid: dbMessage.chat_jid // Importante para que el cliente sepa a qu� chat pertenece
                            };
                            io.to(`session-${sessionId}`).emit('message', clientMessage); // Emitir a la sala de la sesi�n
                            console.log(`[${sessionId}] Nuevo mensaje de ${clientMessage.from} para ${clientMessage.chatJid} guardado y emitido: ${clientMessage.message}`);
                        }
                    } else {
                         console.log(`[${sessionId}] Ignoring message without content or ID:`, msg.key);
                    }
                }
            }
        });
        
        // Manejar actualizaciones de estado de mensajes
        sock.ev.on('messages.update', async (updates) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando ${updates.length} actualizaciones de mensajes`);
                return;
            }

            console.log(`[${sessionId}] Processing ${updates.length} messages.update from Baileys`);
            for (const update of updates) {
                if (update.key && update.update?.status) {
                    const messageId = update.key.id;
                    const chatJid = update.key.remoteJid;
                    let newStatus;
                    // Traducir el estado de Baileys a nuestro estado de DB
                    switch(update.update.status) {
                        case DisconnectReason.connectionClosed: // Example, not a real status, adjust based on Baileys statuses
                        case 1: // PENDING (no enviado a�n por el servidor de WA) - puede no ser un evento com�n aqu�
                            newStatus = 'pending';
                            break;
                        case 2: // SERVER_ACK (enviado al servidor de WA)
                            newStatus = 'sent';
                            break;
                        case 3: // DELIVERY_ACK (entregado al destinatario)
                            newStatus = 'delivered';
                            break;
                        case 4: // READ_ACK (le�do por el destinatario)
                            newStatus = 'read';
                            break;
                        case 5: // PLAYED_ACK (audio/video reproducido) - podr�amos mapearlo a 'read'
                            newStatus = 'read'; // O un estado 'played' si se quiere diferenciar
                            break;
                        default:
                            console.log(`[${sessionId}] Unknown message status update: ${update.update.status} for ${messageId}`);
                            continue; // No actualizar si no conocemos el estado
                    }

                    const messageToUpdate = {
                        id: messageId,
                        chat_jid: chatJid, // Necesario para identificar la sesi�n si el ID no es globalmente �nico
                        from_me: update.key.fromMe, // from_me es importante para el contexto
                        timestamp: new Date(), // El timestamp del update, no del mensaje original
                        status: newStatus,
                        // No necesitamos todos los campos, solo los que usa saveMessageToDB para la condici�n ON DUPLICATE KEY UPDATE
                        // y los que usamos para identificar un�vocamente (id, session_id - que se pasa a saveMessageToDB)
                        // session_id, sender_jid, message_type, text_content, etc. pueden ser undefined aqu�.
                    };
                    
                    // Reutilizar saveMessageToDB con ON DUPLICATE KEY UPDATE status = VALUES(status)
                    // Necesitamos asegurar que saveMessageToDB tiene la logica de session_id
                    await saveMessageToDB(sessionId, messageToUpdate); 
                    console.log(`[${sessionId}] Message ${messageId} in chat ${chatJid} status updated to ${newStatus} in DB.`);

                    // Emitir actualizaci�n de estado al cliente
                    io.to(`session-${sessionId}`).emit('message-status-update', {
                        messageId: messageId,  // Corregido para coincidir con el frontend
                        chatJid: chatJid,
                        status: newStatus,
                        timestamp: new Date().toISOString()
                    });
                }
            }
        });

        // Capturar contactos cuando se actualicen
        sock.ev.on('contacts.update', async (contactsUpdate) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando ${contactsUpdate.length} actualizaciones de contactos`);
                return;
            }

            console.log(`[${sessionId}] Processing ${contactsUpdate.length} contacts.update from Baileys`);
            const phoneNumber = await getUserPhoneNumber(sessionId);
            for (const contact of contactsUpdate) {
                if (contact.id && (contact.id.includes('@s.whatsapp.net') || contact.id.includes('@g.us'))) {
                    await getOrInsertContact(contact.id, contact.name, contact.notify, contact.id.includes('@g.us'), phoneNumber);
                }
            }
        });

        // Capturar chats/grupos cuando se actualicen
        sock.ev.on('chats.update', async (chatsUpdate) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando ${chatsUpdate.length} actualizaciones de chats`);
                return;
            }

            console.log(`[${sessionId}] Processing ${chatsUpdate.length} chats.update from Baileys`);
            const phoneNumber = await getUserPhoneNumber(sessionId);
            for (const chat of chatsUpdate) {
                if (chat.id && (chat.id.includes('@s.whatsapp.net') || chat.id.includes('@g.us'))) {
                    await getOrInsertContact(chat.id, chat.name, null, chat.id.includes('@g.us'), phoneNumber);
                    if (chat.id.includes('@g.us') && chat.participants) {
                        // Actualizar miembros del grupo en contact_group_members
                        try {
                            const userSessionId = await getUserSessionId(sessionId);
                            if (userSessionId) {
                                const groupData = { participants: chat.participants };
                                const membersCount = await saveGroupMembersToDatabase(
                                    chat.id,
                                    groupData,
                                    userSessionId,
                                    sock,
                                    sessionId
                                );
                                console.log(`[${sessionId}] ? Grupo ${chat.id} actualizado con ${membersCount} miembros`);
                            }
                        } catch (error) {
                            console.error(`[${sessionId}] ? Error actualizando miembros del grupo ${chat.id}:`, error.message);
                        }
                    }
                }
            }
        });

        // ? EVENTO: group-participants.update - Se dispara cuando cambian participantes de un grupo
        sock.ev.on('group-participants.update', async (participantUpdate) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando actualizaci�n de participantes de grupo`);
                return;
            }

            try {
                const { id: groupJid, participants, action } = participantUpdate;
                console.log(`[${sessionId}] ?? group-participants.update: ${action} en grupo ${groupJid}, participantes: ${participants.join(', ')}`);

                const userSessionId = await getUserSessionId(sessionId);
                if (!userSessionId) {
                    console.error(`[${sessionId}] ? No se pudo obtener userSessionId`);
                    return;
                }

                // Para acciones de a�adir o promover, necesitamos la metadata completa
                if (action === 'add' || action === 'promote' || action === 'demote') {
                    try {
                        // Obtener metadata completa del grupo con participantes actualizados
                        const groupMetadata = await sock.groupMetadata(groupJid);
                        if (groupMetadata && groupMetadata.participants) {
                            const membersCount = await saveGroupMembersToDatabase(
                                groupJid,
                                groupMetadata,
                                userSessionId,
                                sock,
                                sessionId
                            );
                            console.log(`[${sessionId}] ? Actualizado grupo ${groupJid} con ${membersCount} miembros despu�s de ${action}`);
                        }
                    } catch (error) {
                        console.error(`[${sessionId}] ? Error actualizando miembros despu�s de ${action}:`, error.message);
                    }
                }

                // Para acciones de remover, eliminar de la base de datos
                if (action === 'remove') {
                    try {
                        const connection = await pool.getConnection();
                        try {
                            for (const participantJid of participants) {
                                await connection.execute(
                                    'DELETE FROM contact_group_members WHERE contact_jid = ? AND group_jid = ? AND user_session_id = ?',
                                    [participantJid, groupJid, userSessionId]
                                );
                                console.log(`[${sessionId}] ??? Eliminado ${participantJid} del grupo ${groupJid}`);
                            }
                        } finally {
                            connection.release();
                        }
                    } catch (error) {
                        console.error(`[${sessionId}] ? Error eliminando miembros:`, error.message);
                    }
                }
            } catch (error) {
                console.error(`[${sessionId}] ? Error en group-participants.update:`, error.message);
            }
        });

        // ? EVENTO CR�TICO: chats.set - Se dispara al conectar con TODOS los chats
        sock.ev.on('chats.set', async (chatsSet) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando chats.set con ${chatsSet.chats?.length || 0} chats`);
                return;
            }

            console.log(`[${sessionId}] ?? chats.set recibido con ${chatsSet.chats?.length || 0} chats iniciales`);
            if (chatsSet.chats && Array.isArray(chatsSet.chats)) {
                for (const chat of chatsSet.chats) {
                    try {
                        if (chat.id) {
                            const phoneNumber = await getUserPhoneNumber(sessionId);
                            const isGroup = chat.id.includes('@g.us');
                            const chatName = chat.name || chat.subject || chat.id.split('@')[0];
                            await getOrInsertContact(chat.id, chatName, chatName, isGroup, phoneNumber);
                            console.log(`[${sessionId}] Chat guardado desde chats.set: ${chatName} (${chat.id})`);
                        }
                    } catch (error) {
                        console.error(`[${sessionId}] Error guardando chat desde chats.set:`, error);
                    }
                }
            }
        });

        // ? EVENTO CR�TICO: contacts.set - Se dispara al conectar con TODOS los contactos
        sock.ev.on('contacts.set', async (contactsSet) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando contacts.set con ${contactsSet.contacts?.length || 0} contactos`);
                return;
            }

            console.log(`[${sessionId}] ?? contacts.set recibido con ${contactsSet.contacts?.length || 0} contactos iniciales`);
            if (contactsSet.contacts && Array.isArray(contactsSet.contacts)) {
                for (const contact of contactsSet.contacts) {
                    try {
                        if (contact.id && (contact.id.includes('@s.whatsapp.net') || contact.id.includes('@g.us'))) {
                            const isGroup = contact.id.includes('@g.us');
                            const phoneNumber = await getUserPhoneNumber(sessionId);
                            const contactName = contact.name || contact.notify || contact.id.split('@')[0];
                            await getOrInsertContact(contact.id, contactName, contact.notify, isGroup, phoneNumber);
                            console.log(`[${sessionId}] Contacto guardado desde contacts.set: ${contactName} (${contact.id})`);
                        }
                    } catch (error) {
                        console.error(`[${sessionId}] Error guardando contacto desde contacts.set:`, error);
                    }
                }
            }
        });

        // ? EVENTO CR�TICO: messaging-history.set - Historial de mensajes completo
        sock.ev.on('messaging-history.set', async (historySet) => {
            // ? VERIFICAR SI LA SESI�N EST� ACTIVA
            if (!isSessionActive(sessionId)) {
                console.log(`[${sessionId}] ??  Sesi�n NO activa, ignorando messaging-history.set`);
                return;
            }

            console.log(`[${sessionId}] ?????? messaging-history.set recibido!`);
            console.log(`[${sessionId}] ?? Chats: ${historySet.chats?.length || 0}`);
            console.log(`[${sessionId}] ?? Contacts: ${historySet.contacts?.length || 0}`);
            console.log(`[${sessionId}] ?? Messages: ${historySet.messages?.length || 0}`);
            console.log(`[${sessionId}] ?? isLatest: ${historySet.isLatest}`);

            const userSessionId = await getUserSessionId(sessionId);
            const phoneNumber = await getUserPhoneNumber(sessionId);

            if (!phoneNumber) {
                console.error(`[${sessionId}] ? No se pudo obtener phoneNumber para sessionId. Saltando sincronizaci�n de historial.`);
                return;
            }

            if (!userSessionId) {
                console.error(`[${sessionId}] ? No se pudo obtener userSessionId para sessionId. Saltando sincronizaci�n de historial.`);
                return;
            }

            // ? VERIFICAR PRIMERO SI YA EXISTEN DATOS EN LA BD
            if (pool) {
                try {
                    const connection = await pool.getConnection();
                    try {
                        const [existingContacts] = await connection.execute(
                            'SELECT COUNT(*) as count FROM contacts WHERE session_id = ?',
                            [phoneNumber]
                        );

                        const contactCount = existingContacts[0].count;

                        if (contactCount > 100) {
                            console.log(`[${sessionId}] ??  YA HAY ${contactCount} CONTACTOS EN BD.`);
                            console.log(`[${sessionId}] ??  PERO a�n procesaremos mensajes para agregar miembros a grupos...`);
                            // NO SALTAR - continuar para procesar mensajes y agregar miembros
                        } else {
                            console.log(`[${sessionId}] ?? Solo hay ${contactCount} contactos. Descargando historial completo...`);
                        }
                    } finally {
                        connection.release();
                    }
                } catch (err) {
                    console.error(`[${sessionId}] ?? Error verificando BD. Continuando con descarga:`, err.message);
                }
            }

            // Procesar CHATS del historial
            if (historySet.chats && historySet.chats.length > 0) {
                console.log(`[${sessionId}] ?? Guardando ${historySet.chats.length} chats del historial...`);
                
                // Filtrar solo grupos
                const groups = historySet.chats.filter(chat => chat.id?.includes('@g.us'));
                console.log(`[${sessionId}] ?? Encontrados ${groups.length} grupos en el historial`);
                
                for (const chat of historySet.chats) {
                    try {
                        const chatJid = chat.id;
                        const isGroup = chatJid?.includes('@g.us');
                        const chatName = chat.name || chat.subject || (chatJid ? chatJid.split('@')[0] : 'Unknown');

                        if (chatJid) {
                            await getOrInsertContact(chatJid, chatName, chatName, isGroup, phoneNumber);

                            // Si es un grupo, obtener metadata completa
                            if (isGroup && pool) {
                                try {
                                    const groupMetadata = await sock.groupMetadata(chatJid).catch(() => null);
                                    if (groupMetadata) {
                                        const connection = await pool.getConnection();
                                        try {
                                            // Actualizar informaci�n del grupo
                                            await connection.execute(
                                                'UPDATE contacts SET name = ?, notify_name = ?, avatar_url = ? WHERE jid = ? AND session_id = ?',
                                                [
                                                    groupMetadata.subject || chatName,
                                                    groupMetadata.subject || chatName,
                                                    groupMetadata.pic || null,
                                                    chatJid,
                                                    phoneNumber
                                                ]
                                            );
                                            console.log(`[${sessionId}] ? Grupo actualizado: ${groupMetadata.subject || chatName} (${groupMetadata.participants?.length || 0} miembros)`);
                                        } finally {
                                            connection.release();
                                        }

                                        // Guardar miembros del grupo en contact_group_members
                                        if (groupMetadata.participants && groupMetadata.participants.length > 0) {
                                            try {
                                                const membersCount = await saveGroupMembersToDatabase(
                                                    chatJid,
                                                    groupMetadata,
                                                    userSessionId,
                                                    sock,
                                                    sessionId
                                                );
                                                console.log(`[${sessionId}] ?? Guardados ${membersCount} miembros del grupo ${groupMetadata.subject || chatName}`);
                                            } catch (memberError) {
                                                console.error(`[${sessionId}] ? Error guardando miembros del grupo ${chatJid}:`, memberError.message);
                                            }
                                        }
                                    }
                                } catch (groupError) {
                                    console.log(`[${sessionId}] ?? No se pudo obtener metadata del grupo ${chatJid}:`, groupError.message);
                                }
                            }

                            // Descargar imagen de perfil
                            try {
                                const profilePicUrl = await sock.profilePictureUrl(chatJid, 'image').catch(() => null);
                                if (profilePicUrl && pool) {
                                    const connection = await pool.getConnection();
                                    try {
                                        await connection.execute(
                                            'UPDATE contacts SET avatar_url = ? WHERE jid = ?',
                                            [profilePicUrl, chatJid]
                                        );
                                        console.log(`[${sessionId}] ??? Avatar descargado para: ${chatName}`);
                                    } finally {
                                        connection.release();
                                    }
                                }
                            } catch (avatarErr) {
                                // Ignorar errores de avatar, no es cr�tico
                            }
                        }
                    } catch (err) {
                        console.error(`[${sessionId}] Error guardando chat del historial:`, err.message);
                    }
                }
                console.log(`[${sessionId}] ? Chats del historial guardados`);
            }

            // Procesar CONTACTOS del historial
            if (historySet.contacts && historySet.contacts.length > 0) {
                console.log(`[${sessionId}] ?? Guardando ${historySet.contacts.length} contactos del historial...`);
                for (const contact of historySet.contacts) {
                    try {
                        const contactJid = contact.id;
                        const isGroup = contactJid?.includes('@g.us');
                        const contactName = contact.name || contact.notify || (contactJid ? contactJid.split('@')[0] : 'Unknown');

                        if (contactJid) {
                            await getOrInsertContact(contactJid, contactName, contact.notify, isGroup, phoneNumber);

                            // Descargar imagen de perfil del contacto
                            try {
                                const profilePicUrl = await sock.profilePictureUrl(contactJid, 'image').catch(() => null);
                                if (profilePicUrl && pool) {
                                    const connection = await pool.getConnection();
                                    try {
                                        await connection.execute(
                                            'UPDATE contacts SET avatar_url = ? WHERE jid = ?',
                                            [profilePicUrl, contactJid]
                                        );
                                        console.log(`[${sessionId}] ??? Avatar descargado para contacto: ${contactName}`);
                                    } finally {
                                        connection.release();
                                    }
                                }
                            } catch (avatarErr) {
                                // Ignorar errores de avatar, no es cr�tico
                            }
                        }
                    } catch (err) {
                        console.error(`[${sessionId}] Error guardando contacto del historial:`, err.message);
                    }
                }
                console.log(`[${sessionId}] ? Contactos del historial guardados`);
            }

            // Procesar MENSAJES del historial
            if (historySet.messages && historySet.messages.length > 0) {
                console.log(`[${sessionId}] ?? Guardando ${historySet.messages.length} mensajes del historial...`);
                let savedCount = 0;
                let groupMessagesCount = 0;
                let participantsFound = 0;

                for (const msg of historySet.messages) {
                    try {
                        const senderJid = msg.key.remoteJid;
                        const participantJid = msg.key.participant;
                        const messageId = msg.key.id;

                        if (!senderJid || !messageId || !msg.message) continue;

                        // Guardar contacto
                        const phoneNumber = await getUserPhoneNumber(sessionId);
                        const isGroup = senderJid.includes('@g.us');
                        await getOrInsertContact(senderJid, null, msg.pushName, isGroup, phoneNumber);

                        if (isGroup && participantJid) {
                            groupMessagesCount++;
                            participantsFound++;

                            await getOrInsertContact(participantJid, msg.pushName, msg.pushName, false, phoneNumber);

                            // DEBUG: Ver formato del participantJid en historial (solo primeros 5 para no hacer spam)
                            if (participantsFound <= 5) {
                                console.log(`[${sessionId}] ?? DEBUG HISTORIAL: participantJid = ${participantJid}`);
                                console.log(`[${sessionId}] ?? DEBUG HISTORIAL: �Tiene @s.whatsapp.net? ${participantJid.includes('@s.whatsapp.net')}`);
                            }

                            // AGREGAR: Guardar como miembro del grupo autom�ticamente desde historial
                            try {
                                if (userSessionId && pool && participantJid.includes('@s.whatsapp.net')) {
                                    const connection = await pool.getConnection();
                                    try {
                                        // Obtener datos del contacto
                                        const [contactData] = await connection.execute(
                                            'SELECT jid, name, notify_name, avatar_url FROM contacts WHERE jid = ? AND session_id = ? LIMIT 1',
                                            [participantJid, phoneNumber]
                                        );

                                        if (contactData.length > 0) {
                                            const contact = contactData[0];
                                            const phoneNum = extractPhoneNumber(participantJid);

                                            // Insertar como miembro del grupo si no existe
                                            await connection.execute(
                                                `INSERT INTO contact_group_members (
                                                    contact_jid, group_jid, is_admin, is_super_admin,
                                                    phone_number, name, notify_name, avatar_url,
                                                    user_session_id, session_id
                                                ) VALUES (?, ?, 0, 0, ?, ?, ?, ?, ?, ?)
                                                ON DUPLICATE KEY UPDATE
                                                    name = VALUES(name),
                                                    notify_name = VALUES(notify_name),
                                                    avatar_url = VALUES(avatar_url),
                                                    updated_at = NOW()`,
                                                [
                                                    participantJid,
                                                    senderJid,
                                                    phoneNum,
                                                    contact.name,
                                                    contact.notify_name,
                                                    contact.avatar_url,
                                                    userSessionId,
                                                    phoneNumber
                                                ]
                                            );
                                            console.log(`[${sessionId}] ?? Miembro agregado al grupo desde historial: ${contact.name || participantJid}`);
                                        }
                                    } finally {
                                        connection.release();
                                    }
                                }
                            } catch (memberError) {
                                // No loggear error para evitar spam en historial
                            }
                        }

                        // Extraer contenido del mensaje
                        const messageType = Object.keys(msg.message)[0] || 'unknown';
                        let textContent = msg.message?.conversation || msg.message?.extendedTextMessage?.text;
                        let mediaUrl = null;
                        let mediaMimeType = null;

                        if (messageType === 'imageMessage' && msg.message.imageMessage) {
                            textContent = msg.message.imageMessage.caption || '';
                            mediaMimeType = msg.message.imageMessage.mimetype;
                            try {
                                // Descargar y procesar la imagen
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando imagen del historial:`, error.message);
                                mediaUrl = null;
                            }
                        } else if (messageType === 'videoMessage' && msg.message.videoMessage) {
                            textContent = msg.message.videoMessage.caption || '';
                            mediaMimeType = msg.message.videoMessage.mimetype;
                            try {
                                // Descargar y procesar el video
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando video del historial:`, error.message);
                                mediaUrl = null;
                            }
                        } else if (messageType === 'audioMessage' && msg.message.audioMessage) {
                            textContent = ''; // Audio no suele tener text_content
                            mediaMimeType = msg.message.audioMessage.mimetype;
                            try {
                                // Descargar y procesar el audio
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando audio del historial:`, error.message);
                                mediaUrl = null;
                            }
                        } else if (messageType === 'documentMessage' && msg.message.documentMessage) {
                            textContent = msg.message.documentMessage.title || msg.message.documentMessage.fileName || 'Document';
                            mediaMimeType = msg.message.documentMessage.mimetype;
                            try {
                                // Descargar y procesar el documento
                                const mediaBuffer = await sessionInfo.sock.downloadMediaMessage(msg, 'buffer');
                                const fileName = `media_${sessionId}_${messageId}_${Date.now()}`;
                                const fileExtension = getExtensionFromMimeType(mediaMimeType);
                                const filePath = path.join('media', fileName + fileExtension);
                                
                                // Asegurar que el directorio media existe
                                if (!fs.existsSync('media')) {
                                    fs.mkdirSync('media', { recursive: true });
                                }
                                
                                fs.writeFileSync(filePath, mediaBuffer);
                                mediaUrl = `/media/${fileName + fileExtension}`;
                            } catch (error) {
                                console.error(`[${sessionId}] Error descargando documento del historial:`, error.message);
                                mediaUrl = null;
                            }
                        }

                        const ownJid = sessionInfo.sock?.user?.id?.replace(/:.*$/, '') + '@s.whatsapp.net';
                        const finalSenderJid = msg.key.fromMe ? ownJid : (participantJid || senderJid);

                        const dbMessage = {
                            id: messageId,
                            chat_jid: senderJid,
                            sender_jid: finalSenderJid,
                            from_me: msg.key.fromMe,
                            message_type: messageType,
                            text_content: textContent,
                            media_url: mediaUrl,
                            media_mime_type: mediaMimeType,
                            timestamp: msg.messageTimestamp ? new Date(Number(msg.messageTimestamp) * 1000) : new Date(),
                            status: msg.key.fromMe ? 'sent' : 'received'
                        };

                        await saveMessageToDB(sessionId, dbMessage);
                        savedCount++;

                        if (savedCount % 100 === 0) {
                            console.log(`[${sessionId}] ?? Procesados ${savedCount}/${historySet.messages.length} mensajes hist�ricos...`);
                        }

                    } catch (err) {
                        console.error(`[${sessionId}] Error guardando mensaje del historial:`, err.message);
                    }
                }
                console.log(`[${sessionId}] ? ${savedCount} mensajes del historial guardados`);
                console.log(`[${sessionId}] ?? ESTAD�STICAS DE MIEMBROS:`);
                console.log(`[${sessionId}]    - Mensajes de grupo procesados: ${groupMessagesCount}`);
                console.log(`[${sessionId}]    - Participantes encontrados: ${participantsFound}`);
            }

            console.log(`[${sessionId}] ?? Sincronizaci�n de historial completada!`);

            // Cargar contactos en tablero "Sin Categor�a" despu�s de sincronizar
            setTimeout(async () => {
                try {
                    console.log(`[${sessionId}] ?? Verificando tableros Kanban para cargar contactos...`);
                    const phoneNumber = await getUserPhoneNumber(sessionId);
                    if (phoneNumber && pool) {
                        await loadContactsToDefaultBoard(phoneNumber);
                    }
                } catch (err) {
                    console.error(`[${sessionId}] Error cargando contactos a tablero por defecto:`, err.message);
                }
            }, 2000);

            // Descargar avatares en batch despu�s de sincronizar
            setTimeout(async () => {
                console.log(`[${sessionId}] ??? Iniciando descarga de avatares...`);
                await downloadAllAvatars(sessionId, sock);
            }, 3000);
        });

        sock.ev.on('creds.update', saveCreds);
        sessions.set(sessionId, sessionInfo);
        return sessionInfo;
    } catch (error) {
        console.error(`[${sessionId}] Error creando sesi�n:`, error);
        // Asegurarse de limpiar la sesi�n si la creaci�n falla a mitad de camino
        if (sessions.has(sessionId)) {
            const failedSession = sessions.get(sessionId);
            if (failedSession.sock) {
                // Intentar cerrar el socket si existe
                try { await failedSession.sock.ws.close(); } catch (e) { /* ignore */ }
            }
            sessions.delete(sessionId);
        }
        io.emit(`connection-${sessionId}`, { status: 'error', error: error.message });
        return null;
    }
};

// ============= ENDPOINTS REALES DE WHATSAPP =============

// Obtener c�digo QR para conectar WhatsApp
app.get('/api/qr-status', async (req, res) => {
    const format = req.query.format || 'json';
    const sessionId = req.query.sessionId || crypto.randomBytes(8).toString('hex');
    
    console.log(`[${sessionId}] Solicitando QR (formato: ${format})`);
    
    // Verificar si ya hay sesi�n conectada
    const existingSession = sessions.get(sessionId);
    if (existingSession && existingSession.isConnected) {
        return res.json({
            success: true,
            sessionId,
            isConnected: true,
            message: 'WhatsApp ya est� conectado'
        });
    }

    // Usar QR existente si es reciente
    if (lastQRSession && !lastQRSession.session.isConnected) {
        const timeSinceCreation = Date.now() - lastQRSession.createdAt;
        if (timeSinceCreation < QR_EXPIRY_TIME) {
            const sessionInfo = lastQRSession.session;
            try {
                if (sessionInfo.qr) {
                    const qrDataUrl = await QRCode.toDataURL(sessionInfo.qr, {
                        width: 300,
                        margin: 1,
                        errorCorrectionLevel: 'H'
                    });
                    return res.json({
                        success: true,
                        sessionId,
                        qrDataUrl,
                        isConnected: sessionInfo.isConnected,
                        timestamp: new Date().toISOString()
                    });
                }
            } catch (error) {
                console.error('Error generando QR:', error);
            }
        }
    }

    // Crear nueva sesi�n
    const sessionInfo = await createSession(sessionId, true);
    if (!sessionInfo) {
        return res.status(500).json({
            success: false,
            error: 'Error creando sesi�n de WhatsApp'
        });
    }

    // Esperar a que se genere el QR
    let attempts = 0;
    while (!sessionInfo.qr && attempts < 10) {
        await new Promise(resolve => setTimeout(resolve, 500));
        attempts++;
    }

    if (sessionInfo.qr) {
        try {
            const qrDataUrl = await QRCode.toDataURL(sessionInfo.qr, {
                width: 300,
                margin: 1,
                errorCorrectionLevel: 'H'
            });
            res.json({
                success: true,
                sessionId,
                qrDataUrl,
                isConnected: sessionInfo.isConnected,
                timestamp: new Date().toISOString()
            });
        } catch (error) {
            res.status(500).json({ 
                success: false, 
                error: 'Error generando c�digo QR' 
            });
        }
    } else {
        res.status(404).json({ 
            success: false, 
            error: 'No se pudo generar el c�digo QR' 
        });
    }
});

// Verificar estado de conexi�n de una sesi�n
app.get('/api/session/:sessionId/status', async (req, res) => {
    const { sessionId } = req.params;

    // 1. Try to get the phone number associated with the provided sessionId
    let phoneNumber = await getUserPhoneNumber(sessionId); // This checks memory first

    // If not found in memory, try to get it from the DB
    if (!phoneNumber && pool) {
        const connection = await pool.getConnection();
        try {
            // Query user_sessions to find the phone number associated with the provided sessionId,
            // prioritizing active sessions.
            const [userRows] = await connection.execute(
                'SELECT phone_number FROM user_sessions WHERE session_id = ? AND is_active = TRUE ORDER BY last_activity DESC LIMIT 1',
                [sessionId]
            );
            if (userRows.length > 0) {
                phoneNumber = userRows[0].phone_number;
            }
        } catch (error) {
            console.error('[SESSION-STATUS] Error consulting user_sessions for phone number:', error);
        } finally {
            connection.release();
        }
    }

    // If we have a phone number, find the currently active session in memory for that phone number
    if (phoneNumber) {
        let activeSession = null;
        let activeSessionId = null;
        // Iterate through all active sessions in memory to find the one matching the phone number
        for (const [sId, sessionData] of sessions.entries()) {
            const currentPhoneNumber = await getUserPhoneNumber(sId); // Get phone number for this session
            if (currentPhoneNumber === phoneNumber) {
                activeSession = sessionData;
                activeSessionId = sId;
                break;
            }
        }

        if (activeSession && activeSession.isConnected) {
            // Found an active session in memory for this phone number
            return res.json({
                success: true,
                isConnected: true,
                phoneNumber: phoneNumber,
                message: 'Sesi�n conectada',
                sessionId: activeSessionId // Return the actual active sessionId
            });
        } else {
            // Session exists in DB but not active in memory, or not connected
            return res.json({
                success: true,
                isConnected: false,
                phoneNumber: phoneNumber,
                message: 'Sesi�n no activa o desconectada',
                sessionId: sessionId // Return the requested sessionId
            });
        }
    } else {
        // No phone number found for the given sessionId, or session is not active in memory
        return res.json({
            success: true,
            isConnected: false,
            message: 'Sesi�n no encontrada o no activa'
        });
    }
});


// Endpoint para obtener listas de grupos
app.get('/api/groups/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    try {
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no conectada. Por favor, conecte WhatsApp primero haciendo clic en "Escanear QR" en la interfaz.',
                groups: [],
                total: 0
            });
        }

        try {
            // Obtener todos los grupos del usuario
            const groupFetchResult = await session.sock.groupFetchAllParticipating().catch(err => {
                console.error('[GET-GROUPS] Error obteniendo grupos:', err);
                return {};
            });

            const groups = Object.values(groupFetchResult || {}).map(group => ({
                id: group.id,
                jid: group.id,
                name: group.subject || group.name || group.id.split('@')[0],
                subject: group.subject,
                size: (group.participants || group.participant || []).length,
                memberCount: (group.participants || group.participant || []).length,
                creation: group.creation,
                owner: group.owner
            }));

            res.json({
                success: true,
                groups: groups,
                total: groups.length
            });

        } catch (error) {
            console.error(`[API-GROUPS] Error obteniendo grupos para sesi�n ${sessionId}:`, error);
            res.status(500).json({
                success: false,
                error: 'Error al obtener grupos',
                details: error.message,
                groups: [],
                total: 0
            });
        }

    } catch (error) {
        console.error(`[API-GROUPS] Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor',
            groups: [],
            total: 0
        });
    }
});

// Endpoint para obtener grupos con informaci�n detallada de participantes (especialmente para campa�as)
app.get('/api/groups-with-participants/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    try {
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no conectada'
            });
        }

        try {
            // Obtener todos los grupos del usuario
            const groupFetchResult = await session.sock.groupFetchAllParticipating().catch(err => {
                console.error('[GET-GROUPS-WITH-PARTICIPANTS] Error obteniendo grupos:', err);
                return {};
            });

            const groupsWithParticipants = [];
            
            // Iterar a trav�s de cada grupo para obtener sus participantes
            for (const [groupId, groupData] of Object.entries(groupFetchResult || {})) {
                try {
                    // Obtener metadata del grupo para tener la lista actualizada de participantes
                    const groupMetadata = await session.sock.groupMetadata(groupId);
                    
                    // Filtrar participantes y formatear
                    const participants = (groupMetadata.participants || [])
                        .filter(participant => participant && !participant.id.includes('broadcast'))
                        .map(participant => ({
                            jid: participant.id,
                            phone: participant.id.split('@')[0],
                            name: participant.name || participant.id.split('@')[0],
                            notifyName: participant.notifyName || participant.name,
                            isAdmin: participant.admin === 'admin' || participant.admin === 'superadmin'
                        }));

                    groupsWithParticipants.push({
                        id: groupId,
                        jid: groupId,
                        name: groupMetadata.subject || groupMetadata.name || groupId.split('@')[0],
                        subject: groupMetadata.subject,
                        size: participants.length,
                        creation: groupData.creation,
                        owner: groupData.owner,
                        participants: participants
                    });
                } catch (groupError) {
                    console.error(`[GET-GROUPS-WITH-PARTICIPANTS] Error obteniendo participantes para grupo ${groupId}:`, groupError);
                    // A�adir grupo sin participantes si no se pueden obtener
                    groupsWithParticipants.push({
                        id: groupId,
                        jid: groupId,
                        name: groupData.subject || groupData.name || groupId.split('@')[0],
                        subject: groupData.subject,
                        size: 0,
                        creation: groupData.creation,
                        owner: groupData.owner,
                        participants: []
                    });
                }
            }

            res.json({
                success: true,
                groups: groupsWithParticipants,
                total: groupsWithParticipants.length
            });

        } catch (error) {
            console.error(`[API-GROUPS-WITH-PARTICIPANTS] Error obteniendo grupos con participantes para sesi�n ${sessionId}:`, error);
            res.status(500).json({
                success: false,
                error: 'Error al obtener grupos con participantes',
                details: error.message
            });
        }

    } catch (error) {
        console.error(`[API-GROUPS-WITH-PARTICIPANTS] Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor'
        });
    }
});

// Endpoint optimizado para campa�as - obtener contactos �nicos de m�ltiples grupos
app.post('/api/campaigns/group-contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    const { groupIds } = req.body;

    console.log(`[CAMPAIGN-GROUPS] ?? Solicitud recibida para sessionId: ${sessionId}`);
    console.log(`[CAMPAIGN-GROUPS] ?? Body recibido:`, req.body);

    if (!sessionId) {
        console.error(`[CAMPAIGN-GROUPS] ? sessionId faltante en par�metros de ruta`);
        return res.status(400).json({
            success: false,
            error: 'sessionId es requerido en la URL'
        });
    }

    if (!groupIds || !Array.isArray(groupIds) || groupIds.length === 0) {
        console.error(`[CAMPAIGN-GROUPS] ? groupIds faltante o inv�lido en body`);
        return res.status(400).json({
            success: false,
            error: 'groupIds es requerido como array en el body'
        });
    }

    console.log(`[CAMPAIGN-GROUPS] ?? Procesando ${groupIds.length} grupos:`, groupIds);

    if (groupIds.length === 0) {
        console.log(`[CAMPAIGN-GROUPS] ?? No hay grupos para procesar`);
        return res.json({ success: true, contacts: [], totalUniqueContacts: 0 });
    }

    try {
        // Verificar que la sesi�n existe y est� conectada
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            console.error(`[CAMPAIGN-GROUPS] ? Sesi�n ${sessionId} no encontrada o no conectada`);
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no conectada. Verifica que WhatsApp est� conectado.'
            });
        }

        console.log(`[CAMPAIGN-GROUPS] ?? Procesando contactos de ${groupIds.length} grupos...`);
        const uniqueContacts = new Map();

        for (const groupId of groupIds) {
            if (!groupId || !groupId.includes('@g.us')) {
                console.warn(`[CAMPAIGN-GROUPS] ?? Saltando grupo inv�lido: ${groupId}`);
                continue;
            }

            try {
                console.log(`[CAMPAIGN-GROUPS] ?? Procesando grupo: ${groupId}`);
                const groupMetadata = await session.sock.groupMetadata(groupId);
                const participants = groupMetadata.participants || [];

                console.log(`[CAMPAIGN-GROUPS] ?? Grupo ${groupId} tiene ${participants.length} participantes`);

                for (const participant of participants) {
                    // Verificar que el participante tenga un ID v�lido
                    const participantId = participant.id || participant.jid;
                    if (!participantId || participantId.includes('broadcast')) {
                        continue;
                    }
                    
                    // Obtener informaci�n del participante
                    const phone = participantId.split('@')[0];
                    const name = participant.name || participant.notifyName || participant.pushName || phone;
                    const notifyName = participant.notifyName || participant.name || participant.pushName || phone;
                    const isAdmin = participant.admin === 'admin' || participant.admin === 'superadmin' || participant.isAdmin;
                    
                    if (!uniqueContacts.has(participantId)) {
                        uniqueContacts.set(participantId, {
                            jid: participantId,
                            phone: phone,
                            name: name,
                            notifyName: notifyName,
                            groups: [groupId],
                            isAdmin: isAdmin
                        });
                        console.log(`[CAMPAIGN-GROUPS] ? Agregado nuevo contacto: ${participantId} (${name})`);
                    } else {
                        const existingContact = uniqueContacts.get(participantId);
                        if (!existingContact.groups.includes(groupId)) {
                            existingContact.groups.push(groupId);
                        }
                        console.log(`[CAMPAIGN-GROUPS] ?? Actualizado contacto existente: ${participantId}`);
                    }
                }
            } catch (groupError) {
                console.error(`[CAMPAIGN-GROUPS] ? Error procesando grupo ${groupId}:`, groupError);
                // Continuar con otros grupos aunque uno falle
            }
        }

        const contacts = Array.from(uniqueContacts.values());
        console.log(`[CAMPAIGN-GROUPS] ? Procesamiento completado. ${contacts.length} contactos �nicos encontrados`);

        res.json({
            success: true,
            contacts: contacts,
            totalUniqueContacts: contacts.length,
            totalGroups: groupIds.length,
            processedGroups: groupIds.length,
            contactsPerGroup: contacts.map(c => ({
                phone: c.phone,
                name: c.name,
                groupsCount: c.groups.length
            }))
        });

    } catch (error) {
        console.error(`[CAMPAIGN-GROUPS] ?? Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener contactos de campa�a',
            details: error.message
        });
    }
});



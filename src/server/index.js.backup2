// Obtener todos los contactos CRM de una sesi�n
app.get('/api/crm/contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible.'
        });
    }

    try {
        const connection = await pool.getConnection();
        try {
            const [contacts] = await connection.execute(
                `SELECT
                    id,
                    session_id,
                    first_name,
                    last_name,
                    email,
                    phone,
                    whatsapp,
                    company,
                    position,
                    avatar,
                    status,
                    source,
                    tags,
                    score,
                    value,
                    stage,
                    assigned_agent,
                    notes,
                    custom_fields,
                    location_city,
                    location_country,
                    preferences,
                    created_at,
                    updated_at,
                    last_contact,
                    next_follow_up
                FROM crm_contacts
                WHERE session_id = ?
                ORDER BY created_at DESC`,
                [sessionId]
            );

            const contactsFormatted = contacts.map(contact => ({
                id: contact.id,
                sessionId: contact.session_id,
                firstName: contact.first_name,
                lastName: contact.last_name,
                email: contact.email,
                phone: contact.phone,
                whatsapp: contact.whatsapp,
                company: contact.company,
                position: contact.position,
                avatar: contact.avatar,
                status: contact.status,
                source: contact.source,
                tags: contact.tags ? contact.tags.split(',') : [],
                score: contact.score,
                value: parseFloat(contact.value || 0),
                stage: contact.stage,
                assignedAgent: contact.assigned_agent,
                notes: contact.notes,
                customFields: contact.custom_fields ? JSON.parse(contact.custom_fields) : {},
                location: {
                    city: contact.location_city,
                    country: contact.location_country
                },
                preferences: contact.preferences ? JSON.parse(contact.preferences) : {},
                createdAt: contact.created_at,
                updatedAt: contact.updated_at,
                lastContact: contact.last_contact,
                nextFollowUp: contact.next_follow_up
            }));

            res.json({
                success: true,
                contacts: contactsFormatted,
                total: contactsFormatted.length
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error(`[API-CRM] Error obteniendo contactos CRM para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener contactos CRM'
        });
    }
});

// Crear nuevo contacto CRM
app.post('/api/crm/contacts', async (req, res) => {
    const {
        sessionId,
        firstName,
        lastName,
        email,
        phone,
        whatsapp,
        company,
        position,
        avatar,
        status,
        source,
        tags,
        score,
        value,
        stage,
        assignedAgent,
        notes,
        customFields,
        location,
        preferences
    } = req.body;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible.'
        });
    }

    if (!sessionId) {
        return res.status(400).json({
            success: false,
            error: 'sessionId es requerido'
        });
    }

    try {
        const connection = await pool.getConnection();
        try {
            // Generar ID �nico
            const contactId = `crm_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`;

            const tagsString = Array.isArray(tags) ? tags.join(',') : '';
            const customFieldsString = customFields ? JSON.stringify(customFields) : null;
            const preferencesString = preferences ? JSON.stringify(preferences) : null;

            await connection.execute(
                `INSERT INTO crm_contacts (
                    id, session_id, first_name, last_name, email, phone, whatsapp,
                    company, position, avatar, status, source, tags, score, value,
                    stage, assigned_agent, notes, custom_fields, location_city,
                    location_country, preferences
                ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
                [
                    contactId, sessionId, firstName, lastName, email, phone, whatsapp,
                    company, position, avatar, status || 'lead', source || 'manual',
                    tagsString, score || 0, value || 0, stage, assignedAgent, notes,
                    customFieldsString, location?.city, location?.country, preferencesString
                ]
            );

            res.json({
                success: true,
                message: 'Contacto CRM creado exitosamente',
                contactId: contactId
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error('[API-CRM] Error creando contacto CRM:', error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al crear contacto CRM'
        });
    }
});

// Actualizar contacto CRM
app.put('/api/crm/contacts/:id', async (req, res) => {
    const { id } = req.params;
    const {
        firstName,
        lastName,
        email,
        phone,
        whatsapp,
        company,
        position,
        avatar,
        status,
        source,
        tags,
        score,
        value,
        stage,
        assignedAgent,
        notes,
        customFields,
        location,
        preferences,
        lastContact,
        nextFollowUp
    } = req.body;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible.'
        });
    }

    try {
        const connection = await pool.getConnection();
        try {
            const tagsString = Array.isArray(tags) ? tags.join(',') : tags || '';
            const customFieldsString = customFields ? JSON.stringify(customFields) : null;
            const preferencesString = preferences ? JSON.stringify(preferences) : null;

            await connection.execute(
                `UPDATE crm_contacts SET
                    first_name = ?,
                    last_name = ?,
                    email = ?,
                    phone = ?,
                    whatsapp = ?,
                    company = ?,
                    position = ?,
                    avatar = ?,
                    status = ?,
                    source = ?,
                    tags = ?,
                    score = ?,
                    value = ?,
                    stage = ?,
                    assigned_agent = ?,
                    notes = ?,
                    custom_fields = ?,
                    location_city = ?,
                    location_country = ?,
                    preferences = ?,
                    last_contact = ?,
                    next_follow_up = ?
                WHERE id = ?`,
                [
                    firstName, lastName, email, phone, whatsapp, company, position,
                    avatar, status, source, tagsString, score, value, stage,
                    assignedAgent, notes, customFieldsString, location?.city,
                    location?.country, preferencesString, lastContact, nextFollowUp, id
                ]
            );

            res.json({
                success: true,
                message: 'Contacto CRM actualizado exitosamente'
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error(`[API-CRM] Error actualizando contacto CRM ${id}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al actualizar contacto CRM'
        });
    }
});


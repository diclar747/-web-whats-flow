// Endpoint espec�fico para la URL exacta que usa el frontend - CONSULTA DESDE BASE DE DATOS
app.get('/api/campaigns/group-contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    const { groupIds } = req.query;

    console.log(`[CAMPAIGN-GROUPS-DB] ?? Solicitud GET recibida para sessionId: ${sessionId}`);
    console.log(`[CAMPAIGN-GROUPS-DB] ?? Par�metros de consulta:`, req.query);
    console.log(`[CAMPAIGN-GROUPS-DB] ?? URL completa:`, req.url);

    if (!sessionId) {
        console.error(`[CAMPAIGN-GROUPS-DB] ? sessionId faltante`);
        return res.status(400).json({
            success: false,
            error: 'sessionId es requerido'
        });
    }

    if (!groupIds) {
        console.error(`[CAMPAIGN-GROUPS-DB] ? groupIds faltante`);
        return res.status(400).json({
            success: false,
            error: 'groupIds es requerido como par�metro de consulta'
        });
    }

    const groupIdsArray = Array.isArray(groupIds) ? groupIds : groupIds.split(',');
    console.log(`[CAMPAIGN-GROUPS-DB] ?? Procesando ${groupIdsArray.length} grupos desde BD:`, groupIdsArray);

    if (groupIdsArray.length === 0) {
        console.log(`[CAMPAIGN-GROUPS-DB] ?? No hay grupos para procesar`);
        return res.json({ success: true, contacts: [], totalUniqueContacts: 0 });
    }

    try {
        // Obtener user_session_id desde la sesi�n
        const userPhoneNumber = await getUserPhoneNumber(sessionId);
        if (!userPhoneNumber) {
            console.error(`[CAMPAIGN-GROUPS-DB] ? No se pudo obtener el n�mero de tel�fono para sessionId: ${sessionId}`);
            return res.status(400).json({
                success: false,
                error: 'No se pudo identificar el usuario. Verifica que WhatsApp est� conectado.'
            });
        }

        const userSessionId = await getOrCreateUserSession(sessionId, userPhoneNumber);
        console.log(`[CAMPAIGN-GROUPS-DB] ?? Usuario identificado: ${userPhoneNumber} (user_session_id: ${userSessionId})`);

        console.log(`[CAMPAIGN-GROUPS-DB] ?? Consultando contactos de ${groupIdsArray.length} grupos desde BD...`);
        
        // Consultar miembros de los grupos desde la base de datos
        const connection = await pool.getConnection();
        try {
            // Crear placeholders para la consulta SQL
            const placeholders = groupIdsArray.map(() => '?').join(',');
            
            // Consultar miembros de los grupos seleccionados
            const [members] = await connection.execute(
                `SELECT
                    cgm.contact_jid,
                    cgm.phone_number,
                    cgm.is_admin,
                    cgm.is_super_admin,
                    cgm.group_jid,
                    cg.name as group_name
                FROM contact_group_members cgm
                LEFT JOIN contact_groups cg ON cgm.group_jid = cg.jid
                WHERE cgm.group_jid IN (${placeholders})
                AND cgm.user_session_id = ?
                ORDER BY cgm.phone_number, cgm.group_jid`,
                [...groupIdsArray, userSessionId]
            );

            console.log(`[CAMPAIGN-GROUPS-DB] ?? Se encontraron ${members.length} registros de miembros en BD`);

            // Procesar los resultados para crear contactos �nicos
            const uniqueContacts = new Map();

            for (const member of members) {
                const contactJid = member.contact_jid;
                const phoneNumber = member.phone_number;
                const groupJid = member.group_jid;
                const groupName = member.group_name || groupJid;
                const isAdmin = member.is_admin || member.is_super_admin;

                // Normalizar n�mero de tel�fono a formato Paraguay
                let normalizedPhone = phoneNumber;
                if (normalizedPhone.startsWith('+')) {
                    normalizedPhone = normalizedPhone.replace('+', '');
                }
                if (normalizedPhone.startsWith('595')) {
                    normalizedPhone = normalizedPhone.replace('595', '0');
                }

                if (!uniqueContacts.has(contactJid)) {
                    uniqueContacts.set(contactJid, {
                        jid: contactJid,
                        phone: normalizedPhone,
                        name: normalizedPhone, // Usar el n�mero como nombre por defecto
                        notifyName: normalizedPhone,
                        groups: [groupJid],
                        groupNames: [groupName],
                        isAdmin: isAdmin,
                        isSuperAdmin: member.is_super_admin
                    });
                    console.log(`[CAMPAIGN-GROUPS-DB] ? Agregado contacto desde BD: ${contactJid} (${normalizedPhone})`);
                } else {
                    const existingContact = uniqueContacts.get(contactJid);
                    if (!existingContact.groups.includes(groupJid)) {
                        existingContact.groups.push(groupJid);
                        existingContact.groupNames.push(groupName);
                    }
                    console.log(`[CAMPAIGN-GROUPS-DB] ?? Actualizado contacto existente: ${contactJid}`);
                }
            }

            const contacts = Array.from(uniqueContacts.values());
            console.log(`[CAMPAIGN-GROUPS-DB] ? Consulta completada. ${contacts.length} contactos �nicos encontrados en BD`);

            res.json({
                success: true,
                contacts: contacts,
                totalUniqueContacts: contacts.length,
                totalGroups: groupIdsArray.length,
                processedGroups: groupIdsArray.length,
                source: 'database',
                contactsPerGroup: contacts.map(c => ({
                    phone: c.phone,
                    name: c.name,
                    groupsCount: c.groups.length
                }))
            });

        } finally {
            connection.release();
        }

    } catch (error) {
        console.error(`[CAMPAIGN-GROUPS-DB] ? Error consultando grupos desde BD:`, error);
        res.status(500).json({
            success: false,
            error: 'Error al consultar contactos de grupos desde la base de datos',
            details: error.message
        });
    }
});


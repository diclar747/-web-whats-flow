// Obtener tableros Kanban de una sesi�n
app.get('/api/kanban/boards/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible'
        });
    }

    try {
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (!phoneNumber) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
            });
        }

        const connection = await pool.getConnection();
        try {
            const [boards] = await connection.execute(
                `SELECT
                    id,
                    session_id,
                    name,
                    color,
                    board_order,
                    is_default,
                    created_at,
                    updated_at
                FROM kanban_boards
                WHERE session_id = ?
                ORDER BY board_order ASC, created_at ASC`,
                [phoneNumber]
            );

            // Si no hay tableros, crear los tableros por defecto
            if (boards.length === 0) {
                console.log(`[${sessionId}] ?? No hay tableros. Creando tableros por defecto...`);

                const defaultBoards = [
                    { id: 'sin_categoria', name: 'Sin Categor�a', color: '#94a3b8', order: 1 },
                    { id: 'interesado', name: 'Interesado', color: '#3b82f6', order: 2 },
                    { id: 'prospecto', name: 'Prospecto', color: '#f59e0b', order: 3 },
                    { id: 'cliente', name: 'Cliente', color: '#10b981', order: 4 }
                ];

                for (const board of defaultBoards) {
                    try {
                        await connection.execute(
                            `INSERT INTO kanban_boards (id, session_id, name, color, board_order, is_default)
                             VALUES (?, ?, ?, ?, ?, 1)
                             ON DUPLICATE KEY UPDATE name = name`,
                            [board.id, phoneNumber, board.name, board.color, board.order]
                        );
                        console.log(`[${sessionId}] ? Tablero creado: ${board.name}`);
                    } catch (err) {
                        console.error(`[${sessionId}] ? Error creando tablero ${board.name}:`, err.message);
                    }
                }

                // Volver a consultar los tableros despu�s de crearlos
                const [newBoards] = await connection.execute(
                    `SELECT
                        id,
                        session_id,
                        name,
                        color,
                        board_order,
                        is_default,
                        created_at,
                        updated_at
                    FROM kanban_boards
                    WHERE session_id = ?
                    ORDER BY board_order ASC, created_at ASC`,
                    [phoneNumber]
                );

                res.json({
                    success: true,
                    boards: newBoards,
                    total: newBoards.length
                });
            } else {
                res.json({
                    success: true,
                    boards: boards,
                    total: boards.length
                });
            }

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error('[API-KANBAN-BOARDS] Error obteniendo tableros Kanban:', error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener tableros Kanban'
        });
    }
});

// Obtener contactos de tableros Kanban organizados por tablero
app.get('/api/kanban/contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible'
        });
    }

    try {
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (!phoneNumber) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
            });
        }

        const connection = await pool.getConnection();
        try {
            // Obtener todos los contactos de Kanban con informaci�n del contacto
            const [kanbanContacts] = await connection.execute(
                `SELECT
                    kc.id,
                    kc.board_id,
                    kc.contact_jid,
                    kc.notes,
                    kc.created_at,
                    kc.updated_at,
                    c.name,
                    c.notify_name,
                    c.avatar_url
                FROM kanban_contacts kc
                INNER JOIN kanban_boards kb ON kc.board_id = kb.id
                LEFT JOIN contacts c ON kc.contact_jid = c.jid AND c.session_id = kb.session_id
                WHERE kb.session_id = ?
                ORDER BY kc.created_at DESC`,
                [phoneNumber]
            );

            // Organizar contactos por tablero
            const contactsByBoard = {};

            for (const contact of kanbanContacts) {
                if (!contactsByBoard[contact.board_id]) {
                    contactsByBoard[contact.board_id] = [];
                }

                contactsByBoard[contact.board_id].push({
                    id: contact.id,
                    jid: contact.contact_jid,
                    phone: contact.contact_jid?.split('@')[0] || '',
                    name: contact.name || contact.notify_name || contact.contact_jid?.split('@')[0] || 'Sin nombre',
                    avatarUrl: contact.avatar_url,
                    notes: contact.notes,
                    category: contact.board_id,
                    addedAt: contact.created_at,
                    updatedAt: contact.updated_at
                });
            }

            res.json({
                success: true,
                contactsByBoard: contactsByBoard,
                totalContacts: kanbanContacts.length
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error('[API-KANBAN-CONTACTS] Error obteniendo contactos de Kanban:', error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener contactos de Kanban'
        });
    }
});

// Endpoint para obtener participantes de un grupo - Optimizado para campa�as
app.get('/api/group/participants/:sessionId/:groupId', async (req, res) => {
    const { sessionId, groupId } = req.params;

    try {
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no conectada'
            });
        }

        try {
            // Obtener metadata completa del grupo desde WhatsApp
            let groupMetadata;
            try {
                groupMetadata = await session.sock.groupMetadata(groupId);
            } catch (metadataError) {
                console.error(`[API-GROUP-PARTICIPANTS] Error obteniendo metadata del grupo ${groupId}:`, metadataError);
                
                // Si no se puede obtener metadata directamente, intentar con groupFetchAllParticipating
                try {
                    const allGroups = await session.sock.groupFetchAllParticipating();
                    if (allGroups && allGroups[groupId]) {
                        groupMetadata = allGroups[groupId];
                    } else {
                        throw new Error('No se pudo acceder al grupo. Verifique que el ID es correcto y que tiene permisos.');
                    }
                } catch (allGroupsError) {
                    console.error(`[API-GROUP-PARTICIPANTS] Error obteniendo todos los grupos:`, allGroupsError);
                    throw new Error('No se pudo acceder al grupo. Verifique que el ID es correcto y que tiene permisos.');
                }
            }

            // Asegurarse de que los participantes existen
            const participantsList = groupMetadata.participants || groupMetadata.participant || [];
            
            // Formatear participantes en el formato exacto que espera el frontend
            const participants = participantsList
                .filter(participant => participant && participant.id) // Asegurarse de que el participante existe y tiene ID
                .map(participant => ({
                    id: participant.id,
                    jid: participant.id,
                    phone: participant.id.split('@')[0],
                    name: participant.name || participant.notifyName || participant.id.split('@')[0],
                    notifyName: participant.notifyName || participant.name,
                    isAdmin: participant.admin === 'admin' || participant.admin === 'superadmin',
                    isSuperAdmin: participant.admin === 'superadmin'
                }))
                // Eliminar participantes duplicados (por si acaso)
                .filter((participant, index, self) => 
                    index === self.findIndex(p => p.jid === participant.jid)
                );

            res.json({
                success: true,
                groupId: groupId,
                groupName: groupMetadata.subject || groupMetadata.name || groupId.split('@')[0],
                participants: participants,
                total: participants.length
            });

        } catch (error) {
            console.error(`[API-GROUP-PARTICIPANTS] Error obteniendo participantes del grupo ${groupId}:`, error);
            res.status(500).json({
                success: false,
                error: 'Error al obtener participantes del grupo',
                details: error.message,
                groupId: groupId,
                groupName: groupId.split('@')[0],
                participants: [],
                total: 0
            });
        }

    } catch (error) {
        console.error(`[API-GROUP-PARTICIPANTS] Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor',
            groupId: groupId,
            groupName: groupId.split('@')[0],
            participants: [],
            total: 0
        });
    }
});

// Endpoint para obtener contactos de un grupo en formato para campa�as
app.get('/api/group/contacts/:sessionId/:groupId', async (req, res) => {
    const { sessionId, groupId } = req.params;

    try {
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no conectada'
            });
        }

        try {
            // Obtener metadata completa del grupo desde WhatsApp
            let groupMetadata;
            try {
                groupMetadata = await session.sock.groupMetadata(groupId);
            } catch (metadataError) {
                console.error(`[API-GROUP-CONTACTS] Error obteniendo metadata del grupo ${groupId}:`, metadataError);
                
                // Si no se puede obtener metadata directamente, intentar con groupFetchAllParticipating
                const allGroups = await session.sock.groupFetchAllParticipating();
                if (allGroups && allGroups[groupId]) {
                    groupMetadata = allGroups[groupId];
                } else {
                    throw new Error('No se pudo acceder al grupo. Verifique que el ID es correcto y que tiene permisos.');
                }
            }

            // Asegurarse de que los participantes existen
            const participants = groupMetadata.participants || groupMetadata.participant || [];
            
            // Formatear participantes para el uso en campa�as
            const contacts = participants
                .filter(participant => participant && !participant.id.includes('broadcast')) // Filtrar broadcasts
                .map(participant => ({
                    jid: participant.id,
                    phone: participant.id.split('@')[0],
                    name: participant.name || participant.id.split('@')[0],
                    notifyName: participant.notifyName || participant.name,
                    isAdmin: participant.admin === 'admin' || participant.admin === 'superadmin'
                }));

            res.json({
                success: true,
                groupId: groupId,
                groupName: groupMetadata.subject || groupMetadata.name || groupId,
                contacts: contacts,
                totalContacts: contacts.length
            });

        } catch (error) {
            console.error(`[API-GROUP-CONTACTS] Error obteniendo contactos del grupo ${groupId}:`, error);
            res.status(500).json({
                success: false,
                error: 'Error al obtener contactos del grupo',
                details: error.message,
                groupId: groupId,
                groupName: groupId.split('@')[0],
                contacts: [],
                totalContacts: 0
            });
        }

    } catch (error) {
        console.error(`[API-GROUP-CONTACTS] Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor',
            groupId: groupId,
            groupName: groupId.split('@')[0],
            contacts: [],
            totalContacts: 0
        });
    }
});

// Endpoint optimizado para campa�as - obtener contactos �nicos de m�ltiples grupos
app.post('/api/campaigns/group-contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    const { groupIds } = req.body;

    console.log(`[CAMPAIGN-GROUPS] ?? Fetching contacts for ${groupIds ? groupIds.length : 0} groups...`);

    if (!groupIds || !Array.isArray(groupIds) || groupIds.length === 0) {
        return res.status(400).json({
            success: false,
            error: 'Se requiere un array de groupIds en el cuerpo de la petici�n'
        });
    }

    try {
        const sessionInfo = sessions.get(sessionId);
        if (!sessionInfo || !sessionInfo.sock) {
            return res.status(404).json({
                success: false,
                error: 'Sesi�n no encontrada o no conectada'
            });
        }

        const uniqueContacts = new Map();

        for (const groupId of groupIds) {
            try {
                console.log(`[CAMPAIGN-GROUPS] ?? Procesando grupo: ${groupId}`);
                
                const participants = await sessionInfo.sock.groupMetadata(groupId)
                    .then(metadata => metadata.participants || [])
                    .catch(err => {
                        console.error(`[CAMPAIGN-GROUPS] ? Error obteniendo metadata del grupo ${groupId}:`, err);
                        return [];
                    });

                console.log(`[CAMPAIGN-GROUPS] ?? Grupo ${groupId} tiene ${participants.length} participantes`);

                for (const participant of participants) {
                    const participantId = participant.id;
                    const phone = participantId.split('@')[0];
                    
                    // Intentar obtener mejor informaci�n del contacto usando la funci�n de b�squeda
                    let contactInfo = null;
                    try {
                        contactInfo = await sessionInfo.sock.contacts[participantId] ||
                                     await sessionInfo.sock.getContact(participantId);
                    } catch (contactError) {
                        console.log(`[CAMPAIGN-GROUPS] ?? No se pudo obtener info detallada para ${participantId}`);
                    }
                    
                    // Usar la mejor informaci�n disponible
                    const name = contactInfo?.name ||
                                participant.name ||
                                participant.notify ||
                                contactInfo?.notify ||
                                phone;
                    const notifyName = contactInfo?.notify ||
                                     participant.notify ||
                                     name;
                    const isAdmin = participant.admin === 'admin' ||
                                  participant.admin === 'superadmin' ||
                                  participant.isAdmin;
                    
                    if (!uniqueContacts.has(participantId)) {
                        uniqueContacts.set(participantId, {
                            jid: participantId,
                            phone: phone,
                            name: name,
                            notifyName: notifyName,
                            groups: [groupId],
                            isAdmin: isAdmin,
                            avatarUrl: contactInfo?.imgUrl || null
                        });
                        console.log(`[CAMPAIGN-GROUPS] ? Agregado nuevo contacto: ${participantId} (${name})`);
                    } else {
                        const existingContact = uniqueContacts.get(participantId);
                        if (!existingContact.groups.includes(groupId)) {
                            existingContact.groups.push(groupId);
                        }
                        console.log(`[CAMPAIGN-GROUPS] ?? Actualizado contacto existente: ${participantId}`);
                    }
                }
            } catch (groupError) {
                console.error(`[CAMPAIGN-GROUPS] ? Error procesando grupo ${groupId}:`, groupError);
                // Continuar con otros grupos aunque uno falle
            }
        }

        const contacts = Array.from(uniqueContacts.values());
        console.log(`[CAMPAIGN-GROUPS] ? Procesamiento completado. ${contacts.length} contactos �nicos encontrados`);

        res.json({
            success: true,
            contacts: contacts,
            totalUniqueContacts: contacts.length,
            totalGroups: groupIds.length,
            processedGroups: groupIds.length
        });

    } catch (error) {
        console.error(`[CAMPAIGN-GROUPS] ?? Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener contactos de campa�a',
            details: error.message
        });
    }
});

// Endpoint espec�fico para la URL exacta que usa el frontend
app.get('/api/campaigns/group-contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    const { groupIds } = req.query;

    console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? Fetching contacts for session ${sessionId} with groups: ${groupIds}`);

    if (!groupIds) {
        return res.status(400).json({
            success: false,
            error: 'Se requiere el par�metro groupIds en la consulta'
        });
    }

    const groupIdsArray = groupIds.split(',').filter(id => id.trim());
    
    if (groupIdsArray.length === 0) {
        return res.status(400).json({
            success: false,
            error: 'Se requiere al menos un groupId v�lido'
        });
    }

    try {
        const sessionInfo = sessions.get(sessionId);
        if (!sessionInfo || !sessionInfo.sock) {
            return res.status(404).json({
                success: false,
                error: 'Sesi�n no encontrada o no conectada'
            });
        }

        const uniqueContacts = new Map();

        for (const groupId of groupIdsArray) {
            try {
                console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? Procesando grupo: ${groupId}`);
                
                const participants = await sessionInfo.sock.groupMetadata(groupId)
                    .then(metadata => metadata.participants || [])
                    .catch(err => {
                        console.error(`[CAMPAIGN-GROUPS-FRONTEND] ? Error obteniendo metadata del grupo ${groupId}:`, err);
                        return [];
                    });

                console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? Grupo ${groupId} tiene ${participants.length} participantes`);

                // Funci�n para normalizar n�meros de tel�fono a formato Paraguay
                const normalizePhoneNumber = (phone) => {
                    // Limpiar el n�mero (remover caracteres no num�ricos)
                    const cleanPhone = phone.replace(/\D/g, '');
                    
                    // Si el n�mero ya empieza con 595, mantenerlo
                    if (cleanPhone.startsWith('595')) {
                        return cleanPhone;
                    }
                    
                    // Si es un n�mero internacional largo, convertirlo a formato Paraguay
                    if (cleanPhone.length > 9 && !cleanPhone.startsWith('595')) {
                        // Extraer los �ltimos 9 d�gitos (formato paraguayo)
                        const last9Digits = cleanPhone.slice(-9);
                        // Verificar que los �ltimos 9 d�gitos sean un n�mero v�lido de Paraguay
                        if (last9Digits.length === 9 && /^[0-9]{9}$/.test(last9Digits)) {
                            return '595' + last9Digits;
                        }
                    }
                    
                    // Si es un n�mero local sin c�digo de pa�s, agregar 595
                    if (cleanPhone.length === 9 && /^[0-9]{9}$/.test(cleanPhone)) {
                        return '595' + cleanPhone;
                    }
                    
                    // Si es un n�mero de 10 d�gitos que empieza con 9 (formato paraguayo com�n)
                    if (cleanPhone.length === 10 && cleanPhone.startsWith('9')) {
                        return '595' + cleanPhone;
                    }
                    
                    // Devolver el n�mero original si no coincide con ning�n patr�n
                    console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? N�mero no normalizado: ${phone} -> ${cleanPhone}`);
                    return cleanPhone;
                };

                for (const participant of participants) {
                    const participantId = participant.id;
                    const rawPhone = participantId.split('@')[0];
                    const phone = normalizePhoneNumber(rawPhone);
                    
                    // Intentar obtener mejor informaci�n del contacto usando la funci�n de b�squeda
                    let contactInfo = null;
                    try {
                        contactInfo = await sessionInfo.sock.contacts[participantId] ||
                                     await sessionInfo.sock.getContact(participantId);
                    } catch (contactError) {
                        console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? No se pudo obtener info detallada para ${participantId}`);
                    }
                    
                    // Intentar obtener informaci�n del contacto desde la base de datos local
                    let dbContactInfo = null;
                    try {
                        if (pool) {
                            const connection = await pool.getConnection();
                            try {
                                const [contacts] = await connection.execute(
                                    'SELECT name, notify_name, avatar_url FROM contacts WHERE jid = ? AND session_id = ?',
                                    [participantId, sessionInfo.phoneNumber]
                                );
                                if (contacts.length > 0) {
                                    dbContactInfo = contacts[0];
                                }
                            } finally {
                                connection.release();
                            }
                        }
                    } catch (dbError) {
                        console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? No se pudo obtener info de BD para ${participantId}`);
                    }
                    
                    // Usar la mejor informaci�n disponible (priorizar BD, luego WhatsApp, luego n�mero)
                    const name = dbContactInfo?.name ||
                                contactInfo?.name ||
                                participant.name ||
                                participant.notify ||
                                contactInfo?.notify ||
                                dbContactInfo?.notify_name ||
                                phone;
                    const notifyName = dbContactInfo?.notify_name ||
                                     contactInfo?.notify ||
                                     participant.notify ||
                                     name;
                    const isAdmin = participant.admin === 'admin' ||
                                  participant.admin === 'superadmin' ||
                                  participant.isAdmin;
                    
                    if (!uniqueContacts.has(participantId)) {
                        uniqueContacts.set(participantId, {
                            jid: participantId,
                            phone: phone,
                            name: name,
                            notifyName: notifyName,
                            groups: [groupId],
                            isAdmin: isAdmin,
                            avatarUrl: contactInfo?.imgUrl || null
                        });
                        console.log(`[CAMPAIGN-GROUPS-FRONTEND] ? Agregado nuevo contacto: ${participantId} (${name})`);
                    } else {
                        const existingContact = uniqueContacts.get(participantId);
                        if (!existingContact.groups.includes(groupId)) {
                            existingContact.groups.push(groupId);
                        }
                        console.log(`[CAMPAIGN-GROUPS-FRONTEND] ?? Actualizado contacto existente: ${participantId}`);
                    }
                }
            } catch (groupError) {
                console.error(`[CAMPAIGN-GROUPS-FRONTEND] ? Error procesando grupo ${groupId}:`, groupError);
                // Continuar con otros grupos aunque uno falle
            }
        }

        const contacts = Array.from(uniqueContacts.values());
        console.log(`[CAMPAIGN-GROUPS-FRONTEND] ? Procesamiento completado. ${contacts.length} contactos �nicos encontrados`);

        res.json({
            success: true,
            contacts: contacts,
            totalUniqueContacts: contacts.length,
            totalGroups: groupIdsArray.length,
            processedGroups: groupIdsArray.length,
            contactsPerGroup: contacts.map(c => ({
                phone: c.phone,
                name: c.name,
                groupsCount: c.groups.length
            }))
        });

    } catch (error) {
        console.error(`[CAMPAIGN-GROUPS-FRONTEND] ?? Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener contactos de campa�a',
            details: error.message
        });
    }
});


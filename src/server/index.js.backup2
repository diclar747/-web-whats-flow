// GET /api/users/stats - Estad�sticas de usuarios
app.get('/api/users/stats', async (req, res) => {
    try {
        if (!pool) {
            return res.json({
                success: true,
                stats: []
            });
        }

        const connection = await pool.getConnection();
        try {
            const [stats] = await connection.execute(`
                SELECT 
                    u.id,
                    u.name,
                    u.email,
                    u.role,
                    u.department,
                    COUNT(DISTINCT ca.id) as assigned_chats,
                    COUNT(DISTINCT m.id) as total_messages_sent,
                    MAX(m.timestamp) as last_message_time
                FROM users u
                LEFT JOIN chat_assignments ca ON u.id = ca.user_id AND ca.status = 'active'
                LEFT JOIN messages m ON u.id = m.user_id AND m.from_me = 1
                GROUP BY u.id, u.name, u.email, u.role, u.department
                ORDER BY u.created_at DESC
            `);

            res.json({
                success: true,
                stats: stats || []
            });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[API-USERS-STATS] Error obteniendo estad�sticas:', error);
        res.status(500).json({
            success: false,
            error: 'Error al obtener estad�sticas'
        });
    }
});

// GET /api/chat-assignments/:sessionId - Obtener asignaciones de chats
app.get('/api/chat-assignments/:sessionId', async (req, res) => {
    try {
        const { sessionId } = req.params;

        if (!pool) {
            return res.json({
                success: true,
                assignments: []
            });
        }

        const connection = await pool.getConnection();
        try {
            // Crear tabla chat_assignments si no existe
            await connection.execute(`
                CREATE TABLE IF NOT EXISTS chat_assignments (
                    id INT AUTO_INCREMENT PRIMARY KEY,
                    session_id VARCHAR(255),
                    chat_jid VARCHAR(255) NOT NULL,
                    contact_name VARCHAR(255),
                    user_id INT,
                    status ENUM('active', 'inactive', 'transferred') DEFAULT 'active',
                    assigned_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                    INDEX idx_session_id (session_id),
                    INDEX idx_chat_jid (chat_jid),
                    INDEX idx_user_id (user_id)
                ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci
            `);

            const [assignments] = await connection.execute(`
                SELECT 
                    ca.id,
                    ca.session_id,
                    ca.chat_jid,
                    ca.contact_name,
                    ca.user_id,
                    ca.status,
                    ca.assigned_at,
                    u.name as assigned_user_name,
                    u.email as assigned_user_email
                FROM chat_assignments ca
                LEFT JOIN users u ON ca.user_id = u.id
                WHERE ca.session_id = ? OR ca.session_id IS NULL
                ORDER BY ca.assigned_at DESC
            `, [sessionId]);

            res.json({
                success: true,
                assignments: assignments || [],
                total: assignments?.length || 0
            });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[API-CHAT-ASSIGNMENTS] Error obteniendo asignaciones:', error);
        res.status(500).json({
            success: false,
            error: 'Error al obtener asignaciones de chats',
            assignments: []
        });
    }
});

// POST /api/chats/transfer - Transferir chat a usuario
app.post('/api/chats/transfer', async (req, res) => {
    try {
        const { sessionId, chatJid, fromUserId, toUserId, reason } = req.body;

        if (!chatJid || !toUserId) {
            return res.status(400).json({
                success: false,
                error: 'chatJid y toUserId son requeridos'
            });
        }

        if (!pool) {
            return res.json({
                success: true,
                message: 'Chat transferido (modo memoria)'
            });
        }

        const connection = await pool.getConnection();
        try {
            // Actualizar la asignación existente
            await connection.execute(`
                UPDATE chat_assignments 
                SET user_id = ?, status = 'active' 
                WHERE chat_jid = ?
            `, [toUserId, chatJid]);

            res.json({
                success: true,
                message: 'Chat transferido exitosamente'
            });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[API-CHAT-TRANSFER] Error transfiriendo chat:', error);
        res.status(500).json({
            success: false,
            error: 'Error al transferir chat'
        });
    }
});


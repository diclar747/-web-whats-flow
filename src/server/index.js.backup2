// POST /api/agent/chat/return - Devolver chat al agente original
app.post('/api/agent/chat/return', async (req, res) => {
    try {
        const { transferId, agentId } = req.body;

        if (!transferId || !agentId) {
            return res.status(400).json({
                success: false,
                error: 'transferId y agentId son requeridos'
            });
        }

        if (!pool) {
            return res.json({
                success: true,
                message: 'Chat devuelto (modo memoria)'
            });
        }

        const connection = await pool.getConnection();
        try {
            // Obtener el chat original
            const [transfers] = await connection.execute(
                'SELECT chat_id, chat_name, session_id, from_agent_id FROM chat_transfers WHERE id = ?',
                [transferId]
            );

            if (transfers.length === 0) {
                return res.status(404).json({
                    success: false,
                    error: 'Transferencia no encontrada'
                });
            }

            const transfer = transfers[0];
            if (!transfer.from_agent_id) {
                return res.status(400).json({
                    success: false,
                    error: 'No hay agente original para devolver'
                });
            }

            // Cerrar la transferencia actual
            await connection.execute(
                `UPDATE chat_transfers
                SET status = 'closed', closed_at = CURRENT_TIMESTAMP, close_reason = 'Devuelto al agente original'
                WHERE id = ?`,
                [transferId]
            );

            // Crear nueva transferencia al agente original
            await connection.execute(
                `INSERT INTO chat_transfers (
                    chat_id, chat_name, session_id, from_agent_id, to_agent_id, status
                ) VALUES (?, ?, ?, ?, ?, 'pending')`,
                [transfer.chat_id, transfer.chat_name, transfer.session_id, agentId, transfer.from_agent_id]
            );

            res.json({
                success: true,
                message: 'Chat devuelto exitosamente'
            });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[AGENT-RETURN] Error devolviendo chat:', error);
        res.status(500).json({ success: false, error: error.message });
    }
});


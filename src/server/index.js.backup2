// Obtener contactos por sesi�n (usando el n�mero de tel�fono del usuario)
app.get('/api/contacts/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({ 
            success: false, 
            error: 'Servicio de base de datos no disponible.' 
        });
    }

    try {
        // Obtener el n�mero de tel�fono del usuario asociado a esta sesi�n
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (!phoneNumber) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
            });
        }

        const connection = await pool.getConnection();
        try {
            // Consultar contactos que est�n asociados a este n�mero de tel�fono
            const [contacts] = await connection.execute(
                `SELECT 
                    jid,
                    name,
                    notify_name,
                    is_group,
                    avatar_url,
                    session_id,
                    created_at,
                    updated_at
                FROM contacts
                WHERE session_id = ?
                ORDER BY name ASC, notify_name ASC`,
                [phoneNumber]
            );

            const contactsFormatted = contacts.map(contact => ({
                jid: contact.jid,
                name: contact.name || contact.notify_name || contact.jid.split('@')[0],
                notifyName: contact.notify_name,
                isGroup: !!contact.is_group,
                avatarUrl: contact.avatar_url,
                sessionId: contact.session_id,
                createdAt: contact.created_at,
                updatedAt: contact.updated_at
            }));

            res.json({
                success: true,
                contacts: contactsFormatted,
                total: contactsFormatted.length
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error(`[API-CONTACTS] Error obteniendo contactos para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener contactos'
        });
    }
});

// Obtener grupos por sesi�n (usando el n�mero de tel�fono del usuario)
app.get('/api/groups/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible.'
        });
    }

    try {
        // Obtener el n�mero de tel�fono del usuario asociado a esta sesi�n
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (!phoneNumber) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
            });
        }

        const connection = await pool.getConnection();
        try {
            // Consultar grupos de la base de datos
            const [groups] = await connection.execute(
                `SELECT
                    jid as id,
                    name,
                    notify_name,
                    is_group,
                    avatar_url,
                    session_id,
                    created_at,
                    updated_at
                FROM contacts
                WHERE session_id = ? AND is_group = TRUE
                ORDER BY name ASC, notify_name ASC`,
                [phoneNumber]
            );

            // Obtener metadata de grupos desde WhatsApp (incluyendo participantes)
            const session = sessions.get(sessionId);
            let groupMetadata = {};

            if (session && session.sock && session.isConnected) {
                try {
                    const groupFetchResult = await session.sock.groupFetchAllParticipating().catch(err => {
                        console.error('[GET-GROUPS] Error obteniendo metadata de grupos:', err);
                        return {};
                    });
                    groupMetadata = groupFetchResult || {};
                } catch (err) {
                    console.error('[GET-GROUPS] Error en groupFetchAllParticipating:', err);
                }
            }

            const groupsFormatted = groups.map(group => {
                // Obtener el conteo de miembros desde la metadata de WhatsApp
                const metadata = groupMetadata[group.id];
                const memberCount = metadata?.participants?.length || 0;

                return {
                    id: group.id,
                    jid: group.id,
                    name: group.name || group.notify_name || group.id.split('@')[0],
                    subject: group.name || group.notify_name,
                    notifyName: group.notify_name,
                    isGroup: true,
                    avatar: group.avatar_url,
                    avatar_url: group.avatar_url,
                    session_id: group.session_id,
                    createdAt: group.created_at,
                    updatedAt: group.updated_at,
                    memberCount: memberCount,
                    member_count: memberCount,
                };
            });

            res.json({
                success: true,
                groups: groupsFormatted,
                total: groupsFormatted.length
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error(`[API-GROUPS] Error obteniendo grupos para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener grupos'
        });
    }
});

// Endpoint para cargar campa�as
app.get('/api/campaigns/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({ 
            success: false, 
            error: 'Servicio de base de datos no disponible.' 
        });
    }

    try {
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (!phoneNumber) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
            });
        }

        const connection = await pool.getConnection();
        try {
            const [dbCampaigns] = await connection.execute(
                'SELECT * FROM campaigns WHERE session_id = ? ORDER BY created_at DESC',
                [phoneNumber]
            );

            const campaigns = dbCampaigns.map(c => ({
                id: c.id.toString(),
                name: c.name,
                type: c.type || 'direct',
                status: c.status,
                message: { text: c.message_template },
                contacts: [], // Los contactos se cargan en el frontend, no se guardan en la campa�a principal
                progress: { total: 0, sent: 0, delivered: 0, failed: 0 }, // El progreso real se maneja en el frontend o se podr�a guardar por separado
                createdAt: c.created_at,
                useIdFlow: !!c.use_id_flow,
                useRandomTiming: !!c.use_random_timing,
                flowConfig: {
                    messagesCount: c.random_timing_msg_count,
                    timeSpanMinutes: c.random_timing_time_span_minutes
                }
            }));

            res.json({
                success: true,
                campaigns: campaigns,
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error(`[API-CAMPAIGNS] Error obteniendo campa�as para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener campa�as'
        });
    }
});



// POST /api/chat/transfer - Transferir chat a un agente
app.post('/api/chat/transfer', async (req, res) => {
    try {
        const { sessionId, chatId, chatName, agentId, fromAgentId } = req.body;

        if (!chatId || !agentId) {
            return res.status(400).json({
                success: false,
                error: 'chatId y agentId son requeridos'
            });
        }

        if (!pool) {
            return res.json({
                success: true,
                message: 'Chat transferido (modo memoria)'
            });
        }

        const connection = await pool.getConnection();
        try {
            await connection.execute(
                `INSERT INTO chat_transfers (
                    chat_id, chat_name, session_id, from_agent_id, to_agent_id, status
                ) VALUES (?, ?, ?, ?, ?, 'pending')`,
                [chatId, chatName || chatId, sessionId || 'default', fromAgentId || null, agentId]
            );

            res.json({
                success: true,
                message: 'Chat transferido exitosamente'
            });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[TRANSFER] Error transfiriendo chat:', error);
        res.status(500).json({ success: false, error: error.message });
    }
});

// GET /api/agent/:agentId/chats - Obtener chats transferidos a un agente
app.get('/api/agent/:agentId/chats', async (req, res) => {
    try {
        const { agentId } = req.params;

        if (!pool) {
            return res.json({
                success: true,
                chats: []
            });
        }

        const connection = await pool.getConnection();
        try {
            const [chats] = await connection.execute(
                `SELECT
                    id, chat_id, chat_name, session_id, from_agent_id,
                    to_agent_id, status, last_message, unread_count,
                    transferred_at, accepted_at, closed_at, close_reason
                FROM chat_transfers
                WHERE to_agent_id = ?
                ORDER BY
                    CASE status
                        WHEN 'pending' THEN 1
                        WHEN 'accepted' THEN 2
                        WHEN 'closed' THEN 3
                        ELSE 4
                    END,
                    transferred_at DESC`,
                [agentId]
            );

            res.json({ success: true, chats });
        } finally {
            connection.release();
        }
    } catch (error) {
        console.error('[AGENT-CHATS] Error obteniendo chats:', error);
        res.status(500).json({ success: false, error: error.message });
    }
});


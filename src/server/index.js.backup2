// Obtener participantes de un grupo espec�fico
app.get('/api/group/participants/:sessionId/:groupId', async (req, res) => {
    const { sessionId, groupId } = req.params;

    try {
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no conectada'
            });
        }

        try {
            // Obtener metadata completa del grupo desde WhatsApp
            const groupMetadata = await session.sock.groupMetadata(groupId);

            // Formatear participantes
            const participants = groupMetadata.participants.map(participant => ({
                id: participant.id,
                phone: participant.id.split('@')[0],
                isAdmin: participant.admin === 'admin' || participant.admin === 'superadmin',
                isSuperAdmin: participant.admin === 'superadmin'
            }));

            res.json({
                success: true,
                groupId: groupId,
                groupName: groupMetadata.subject,
                participants: participants,
                total: participants.length
            });

        } catch (error) {
            console.error(`[API-GROUP-PARTICIPANTS] Error obteniendo participantes del grupo ${groupId}:`, error);
            res.status(500).json({
                success: false,
                error: 'Error al obtener participantes del grupo',
                details: error.message
            });
        }

    } catch (error) {
        console.error(`[API-GROUP-PARTICIPANTS] Error general para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor'
        });
    }
});

// Endpoint para estad�sticas del Dashboard
app.get('/api/dashboard/stats/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    if (!pool) {
        return res.status(503).json({
            success: false,
            error: 'Servicio de base de datos no disponible.'
        });
    }

    try {
        const phoneNumber = await getUserPhoneNumber(sessionId);
        if (!phoneNumber) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
            });
        }

        const connection = await pool.getConnection();
        try {
            // Contar mensajes por estado
            const [messageStats] = await connection.execute(
                `SELECT
                    COUNT(*) as total_messages,
                    SUM(CASE WHEN from_me = 1 THEN 1 ELSE 0 END) as sent_messages,
                    SUM(CASE WHEN from_me = 0 THEN 1 ELSE 0 END) as received_messages,
                    SUM(CASE WHEN from_me = 1 AND status = 'pending' THEN 1 ELSE 0 END) as pending_messages,
                    SUM(CASE WHEN from_me = 1 AND status = 'sent' THEN 1 ELSE 0 END) as sent_status,
                    SUM(CASE WHEN from_me = 1 AND status = 'delivered' THEN 1 ELSE 0 END) as delivered_messages,
                    SUM(CASE WHEN from_me = 1 AND status = 'read' THEN 1 ELSE 0 END) as read_messages,
                    SUM(CASE WHEN from_me = 1 AND status = 'failed' THEN 1 ELSE 0 END) as failed_messages
                FROM messages
                WHERE session_id = ?`,
                [phoneNumber]
            );

            // Contar contactos y grupos
            const [contactStats] = await connection.execute(
                `SELECT
                    COUNT(*) as total_contacts,
                    SUM(CASE WHEN is_group = 0 THEN 1 ELSE 0 END) as individual_contacts,
                    SUM(CASE WHEN is_group = 1 THEN 1 ELSE 0 END) as groups
                FROM contacts
                WHERE session_id = ?`,
                [phoneNumber]
            );

            // Mensajes hoy
            const [todayMessages] = await connection.execute(
                `SELECT COUNT(*) as today_messages
                FROM messages
                WHERE session_id = ? AND DATE(timestamp) = CURDATE()`,
                [phoneNumber]
            );

            // Mensajes esta semana
            const [weekMessages] = await connection.execute(
                `SELECT COUNT(*) as week_messages
                FROM messages
                WHERE session_id = ? AND YEARWEEK(timestamp, 1) = YEARWEEK(CURDATE(), 1)`,
                [phoneNumber]
            );

            const stats = {
                messages: {
                    total: parseInt(messageStats[0].total_messages) || 0,
                    sent: parseInt(messageStats[0].sent_messages) || 0,
                    received: parseInt(messageStats[0].received_messages) || 0,
                    pending: parseInt(messageStats[0].pending_messages) || 0,
                    delivered: parseInt(messageStats[0].delivered_messages) || 0,
                    read: parseInt(messageStats[0].read_messages) || 0,
                    failed: parseInt(messageStats[0].failed_messages) || 0,
                    today: parseInt(todayMessages[0].today_messages) || 0,
                    thisWeek: parseInt(weekMessages[0].week_messages) || 0
                },
                contacts: {
                    total: parseInt(contactStats[0].total_contacts) || 0,
                    individual: parseInt(contactStats[0].individual_contacts) || 0,
                    groups: parseInt(contactStats[0].groups) || 0
                }
            };

            res.json({
                success: true,
                stats
            });

        } finally {
            if (connection) connection.release();
        }
    } catch (error) {
        console.error(`[API-DASHBOARD-STATS] Error obteniendo estad�sticas para sesi�n ${sessionId}:`, error);
        res.status(500).json({
            success: false,
            error: 'Error interno del servidor al obtener estad�sticas'
        });
    }
});

// Health check
app.get('/api/health', (req, res) => {

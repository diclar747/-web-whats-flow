// Enviar archivo multimedia ya subido
app.post('/api/send/media', async (req, res) => {
  const { sessionId, number, caption, mediaUrl } = req.body;
  
  if (!sessionId || !number || !mediaUrl) {
    return res.status(400).json({ success: false, error: 'Faltan par�metros: sessionId, number, mediaUrl' });
  }

  const session = sessions.get(sessionId);
  if (!session || !session.sock || !session.isConnected) {
    return res.status(400).json({ success: false, error: 'Sesi�n no encontrada, socket no disponible o WhatsApp no conectado' });
  }

  try {
    const jid = number.includes('@') ? number : `${number}@s.whatsapp.net`;
    const phoneNumber = await getUserPhoneNumber(sessionId);
    await getOrInsertContact(jid, null, null, jid.includes('@g.us'), phoneNumber);

    // Determinar tipo de archivo seg�n extensi�n o mimetype
    let messageType = 'document';
    if (mediaUrl.includes('.jpg') || mediaUrl.includes('.jpeg') || mediaUrl.includes('.png') || mediaUrl.includes('.gif') || mediaUrl.includes('.webp')) {
      messageType = 'image';
    } else if (mediaUrl.includes('.mp4') || mediaUrl.includes('.3gp') || mediaUrl.includes('.mov')) {
      messageType = 'video';
    } else if (mediaUrl.includes('.mp3') || mediaUrl.includes('.ogg') || mediaUrl.includes('.wav') || mediaUrl.includes('.m4a')) {
      messageType = 'audio';
    }

    let sentResult;
    // Construir la URL completa del archivo
    const fullMediaUrl = mediaUrl.startsWith('http') ? mediaUrl : `http://127.0.0.1:3002${mediaUrl}`;
    
    // Verificar que el archivo existe antes de enviarlo
    try {
      const url = new URL(fullMediaUrl);
      const response = await fetch(url, { method: 'HEAD' });
      if (!response.ok) {
        throw new Error(`Archivo no encontrado: ${fullMediaUrl}`);
      }
    } catch (urlError) {
      console.error(`[${sessionId}] Error verificando archivo ${fullMediaUrl}:`, urlError);
      return res.status(400).json({ success: false, error: `Archivo no encontrado o no accesible: ${mediaUrl}` });
    }

    switch (messageType) {
      case 'image':
        sentResult = await session.sock.sendMessage(jid, {
          image: { url: fullMediaUrl },
          caption: caption || ''
        });
        break;
      case 'video':
        sentResult = await session.sock.sendMessage(jid, {
          video: { url: fullMediaUrl },
          caption: caption || '',
          gifPlayback: false
        });
        break;
      case 'audio':
        sentResult = await session.sock.sendMessage(jid, {
          audio: { url: fullMediaUrl },
          ptt: false // Mensaje de voz
        });
        break;
      default: // documentos
        sentResult = await session.sock.sendMessage(jid, {
          document: { url: fullMediaUrl },
          fileName: caption || 'archivo',
          mimetype: req.body.mimetype || undefined
        });
        break;
    }

    const ownJid = session.sock?.user?.id?.replace(/:.*$/, '') + '@s.whatsapp.net';

    const dbMessage = {
      id: sentResult.key.id,
      chat_jid: jid,
      sender_jid: ownJid,
      from_me: true,
      message_type: messageType,
      text_content: caption || '',
      media_url: mediaUrl,
      media_mime_type: req.body.mimetype || undefined,
      timestamp: new Date(Number(sentResult.messageTimestamp) * 1000 || Date.now()),
      status: 'pending'
    };
    await saveMessageToDB(sessionId, dbMessage);
    
    const clientMessage = {
      id: dbMessage.id,
      from: 'me',
      to: jid,
      message: dbMessage.text_content,
      mediaUrl: dbMessage.media_url,
      mediaMimeType: dbMessage.media_mime_type,
      timestamp: dbMessage.timestamp.toISOString(),
      type: dbMessage.message_type,
      status: dbMessage.status
    };
    io.to(`session-${sessionId}`).emit('message', clientMessage);
    
    console.log(`[${sessionId}] Archivo multimedia enviado a ${jid} y guardado en DB (pending): ${messageType}`);
    res.json({ success: true, messageId: sentResult.key.id, message: 'Archivo multimedia enviado correctamente', type: messageType });

  } catch (error) {
    console.error(`[${sessionId}] Error enviando archivo multimedia:`, error);
    // Si es un error de conexi�n o sesi�n, devolver un mensaje m�s claro
    if (error.message && (error.message.includes('Session closed') || error.message.includes('Connection terminated'))) {
      return res.status(500).json({ success: false, error: 'La sesi�n de WhatsApp est� cerrada. Por favor, reconecte WhatsApp.', details: error.message });
    }
    res.status(500).json({ success: false, error: 'Error al enviar archivo multimedia', details: error.message });
  }
});

// Obtener mensajes
app.get('/api/messages/:sessionId', async (req, res) => {
    const { sessionId } = req.params;
    const { number, startDate, endDate, limit = 50, offset = 0 } = req.query;

    if (!pool) {
        return res.status(503).json({ success: false, error: 'DB service unavailable' });
    }

    // Obtener el n�mero de tel�fono del usuario en lugar de la session_id temporal
    const phoneNumber = await getUserPhoneNumber(sessionId);
    if (!phoneNumber) {
        return res.status(400).json({
            success: false,
            error: 'No se pudo obtener el n�mero de tel�fono para esta sesi�n'
        });
    }

    const connection = await pool.getConnection();
    try {
        // Modificar query para filtrar por session_id (que ahora contiene el n�mero de tel�fono)
        let query = 'SELECT id, session_id, user_session_id, chat_jid, sender_jid, from_me, message_type, text_content, media_url, media_mime_type, timestamp, status FROM messages WHERE session_id = ?';
        const queryParams = [phoneNumber]; // Usar n�mero de tel�fono en lugar de sessionId

        if (number) {
            const chatJid = number.includes('@') ? number : `${number}@s.whatsapp.net`;
            query += ' AND chat_jid = ?';
            queryParams.push(chatJid);
        }

        if (startDate) {
            query += ' AND timestamp >= ?';
            queryParams.push(new Date(startDate).toISOString().slice(0, 19).replace('T', ' '));
        }
        if (endDate) {
            query += ' AND timestamp <= ?';
            queryParams.push(new Date(endDate).toISOString().slice(0, 19).replace('T', ' '));
        }

        query += ' ORDER BY timestamp DESC';

        const countQuery = query.replace('SELECT id, session_id, user_session_id, chat_jid, sender_jid, from_me, message_type, text_content, media_url, media_mime_type, timestamp, status', 'SELECT COUNT(*) as total');
        const [totalRows] = await connection.execute(countQuery, queryParams);
        const totalMessages = totalRows[0].total;

        query += ' LIMIT ? OFFSET ?';
        queryParams.push(parseInt(limit, 10));
        queryParams.push(parseInt(offset, 10));

        const [messagesFromDB] = await connection.execute(query, queryParams);

        const clientMessages = messagesFromDB.map(msg => ({
            id: msg.id,
            from: msg.from_me ? 'me' : msg.sender_jid,
            to: msg.from_me ? msg.chat_jid : undefined,
            message: msg.text_content,
            mediaUrl: msg.media_url ? `http://127.0.0.1:3002${msg.media_url}` : null,
            mediaMimeType: msg.media_mime_type,
            timestamp: new Date(msg.timestamp).toISOString(),
            type: msg.message_type,
            isFromMe: Boolean(msg.from_me),
            status: msg.status || (msg.from_me ? 'sent' : 'delivered')
        }));

    res.json({
        success: true,
            messages: clientMessages.reverse(),
            totalMessages,
            limit: parseInt(limit, 10),
            offset: parseInt(offset, 10)
        });

    } catch (error) {
        console.error(`[API-MSG] Error fetching messages for session ${sessionId}:`, error);
        res.status(500).json({ success: false, error: 'Failed to retrieve messages from database' });
    } finally {
        if (connection) connection.release();
    }
});

// Endpoint para forzar sincronizaci�n manual del historial
app.post('/api/force-sync/:sessionId', async (req, res) => {
    const { sessionId } = req.params;

    console.log(`[API-SYNC] ?? Solicitud de sincronizaci�n forzada para sessionId: ${sessionId}`);

    try {
        // Verificar que la sesi�n existe y est� conectada
        const session = sessions.get(sessionId);
        if (!session || !session.sock || !session.isConnected) {
            return res.status(400).json({
                success: false,
                error: 'Sesi�n no encontrada, socket no disponible o WhatsApp no conectado'
            });
        }

        // Obtener user_session_id
        const userSessionId = await getUserSessionId(sessionId);
        if (!userSessionId) {
            return res.status(400).json({
                success: false,
                error: 'No se pudo obtener user_session_id. Aseg�rate de que la sesi�n est� registrada.'
            });
        }

        console.log(`[API-SYNC] Iniciando sincronizaci�n para user_session_id: ${userSessionId}`);

        // Ejecutar sincronizaci�n
        const stats = await syncHistoricalData(sessionId, session.sock, userSessionId);

        // Cargar chats actualizados
        const chats = await loadChatListFromDB(sessionId);

        res.json({
            success: true,
            message: 'Sincronizaci�n completada exitosamente',
            stats,
            chatsCount: chats.length
        });

    } catch (error) {
        console.error(`[API-SYNC] ? Error en sincronizaci�n forzada:`, error);
        res.status(500).json({
            success: false,
            error: 'Error durante la sincronizaci�n',
            details: error.message
        });
    }
});


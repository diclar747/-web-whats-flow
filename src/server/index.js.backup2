// SSL certificates
const sslOptions = {
  key: fs.readFileSync(path.join(__dirname, '../../ssl/key.pem')),
  cert: fs.readFileSync(path.join(__dirname, '../../ssl/cert.pem'))
};

const app = express();

// Create both HTTP and HTTPS servers
const httpServer = createServer(app);
const httpsServer = createHttpsServer(sslOptions, app);

// Socket.IO with both servers
const io = new Server(httpServer, {
  cors: {
    origin: [
      'http://127.0.0.1:3000', 
      'http://localhost:3000', 
      'http://127.0.0.1:3001', 
      'http://localhost:3001',
      'https://web.whats-flow.com',  // Añadir dominio de producción
      'http://web.whats-flow.com'    // Añadir también HTTP por si acaso
    ],
    methods: ['GET', 'POST']
  }
});

// Also attach Socket.IO to HTTPS server
const ioHttps = new Server(httpsServer, {
  cors: {
    origin: [
      'http://127.0.0.1:3000', 
      'http://localhost:3000', 
      'http://127.0.0.1:3001', 
      'http://localhost:3001',
      'https://web.whats-flow.com',  // Añadir dominio de producción
      'http://web.whats-flow.com'    // Añadir también HTTP por si acaso
    ],

{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "src/client/build",
  "installCommand": "npm install",
  "builds": [
    {
      "src": "src/server/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/src/server/index.js"
    },
    {
      "src": "/socket.io/(.*)",
      "dest": "/src/server/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/src/client/build/index.html"
    }
  ]
}
